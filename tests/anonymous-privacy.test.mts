const importedSettings={...archive,progress:{...archive.progress,seeded:false,seededCourses:['old-course'],catalogV1:false,theme:'light' as const}};
const currentSettings={...progress,seeded:true,seededCourses:['current-course'],catalogV1:true,theme:'dark' as const};const kept=recoveryProgress(importedSettings,currentSettings);assert.equal(kept.seeded,true);assert.deepEqual(kept.seededCourses,['current-course']);assert.equal(kept.catalogV1,true);assert.equal(kept.theme,'dark');const absent=recoveryProgress(importedSettings,progress);assert.equal(Object.hasOwn(absent,'seededCourses'),false);assert.equal(Object.hasOwn(absent,'catalogV1'),false);assert.equal(Object.hasOwn(absent,'theme'),false);assert.deepEqual(importedSettings.progress.seededCourses,['old-course']);
