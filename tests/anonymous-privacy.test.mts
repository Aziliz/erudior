const encrypted=await encryptText(JSON.stringify(archive),'synthetic recovery passphrase');assert.equal(encrypted.includes('Private local writing'),false);assert.deepEqual(parseAnonymousRecovery(JSON.parse(await decryptText(JSON.parse(encrypted),'synthetic recovery passphrase'))),archive);
