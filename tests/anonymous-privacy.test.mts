const scoped=await captureAnonymousRecovery(progress,session,files,[learnerPrivacyCourse,{...learnerPrivacyCourse,id:'unrelated-profile-course'}],[bank,{...bank,id:'unrelated-profile-bank'}],at);assert(!scoped.sources.some(s=>s.id.startsWith('unrelated')));assert.equal(archive.session,session);assert.deepEqual(anonymousFileIds(progress),['file-one']);
