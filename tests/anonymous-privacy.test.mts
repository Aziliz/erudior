for(const patch of [{family:{}},{consent:true},{scope:'student'},{files:{...files,other:{mime:'text/plain',data:'YQ=='}}},{files:{'file-one':{mime:'text/plain',data:'!' }}},{missingFiles:['file-one']},{sources:[archive.sources[0],archive.sources[0]]}])assert.throws(()=>parseAnonymousRecovery({...archive,...patch}));
for(const patch of [{attempts:null},{stats:[]},{work:{bad:{kind:'writing'}}},{logs:[{...progress.logs![0],date:'2026-02-30'}]},{family:{}},{assessedWorkSubmissions:{bad:{}}},{spreadsheetSubmissions:{bad:{}}},{competencies:{version:1,sources:[],snapshots:[],decisions:[{}]}},{attempts:[{...progress.attempts[0],correct:2}]},{stats:{bank:{q:{seen:1,correct:2,lastCorrect:true,lastSeen:at}}}}])assert.throws(()=>parseAnonymousProgress({...progress,...patch}));
