assert.equal((await previewAnonymousRecovery(archive,[learnerPrivacyCourse],[bank,structuredClone(bank)])).sessionRestorable,true);
const changed=await previewAnonymousRecovery(archive,[],[{...bank,title:'Changed bank'}]);assert.equal(changed.sessionRestorable,false);assert.equal(changed.restoredSession,null);assert.equal(archive.session,session);assert.equal(changed.sourceChanges.length,3);
