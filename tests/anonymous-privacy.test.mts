const resumed=restoreRun(preview.restoredSession!,[bank]);assert(resumed);const resaved=serializeRun(resumed.session,resumed.state);assert.equal(JSON.parse(resaved).session.anonymousRecoverySourceDigest,anonymousRecoveryBankDigest(bank));assert(restoreRun(resaved,[bank]));
