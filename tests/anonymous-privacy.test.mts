for(const chosen of [[0,1],[-1,0],['typed answer','second blank'],['map place'],['print(1)','stamp'],[1,'model-state']])assert.deepEqual(parseAnonymousProgress({...progress,attempts:[{...progress.attempts[0],answers:[{qid:'q',chosen,correct:true}]}]}).attempts[0].answers[0].chosen,chosen);
