import { requestNavigation } from "../src/lib/navigationGuard.ts";
import assert from "node:assert/strict";
import { JSDOM } from "jsdom";
import { emptyCourse, exportCourseSnapshot } from "../src/lib/course.ts";
import { validateSpreadsheetReleaseApproval } from "../src/lib/spreadsheetReleaseApproval.ts";
import type { Course } from "../src/lib/types.ts";
import type { AppApi } from "../src/App.tsx";

const dom = new JSDOM("<!doctype html><body><div id='root'></div></body>", { url: "https://example.test" });
const globals = globalThis as Record<string, unknown>;
Object.assign(globals, { window: dom.window, document: dom.window.document, HTMLElement: dom.window.HTMLElement,
  localStorage: dom.window.localStorage, IS_REACT_ACT_ENVIRONMENT: true });
Object.defineProperty(globalThis, "navigator", { configurable: true, value: dom.window.navigator });
const { createElement, act } = await import("react");
const { createRoot } = await import("react-dom/client");
const { default: CourseEditor } = await import("../src/pages/CourseEditor.tsx");
const { default: SpreadsheetReviewPanel } = await import("../src/components/SpreadsheetReviewPanel.tsx");
const root = createRoot(document.getElementById("root")!);
let saved: Course | undefined;
const notices: string[] = [];
const course = emptyCourse("Workbook course");
course.lessons = [{ id: "intro", module: course.modules[0].id, title: "Introduction", body: "" }, { id: "practice", module: course.modules[0].id, title: "Practice", body: "" }];
const api = { courses: [course], toast: (message: string) => notices.push(message), saveCourse: async (value: Course) => { saved = structuredClone(value); }, go: () => {} } as unknown as AppApi;
const button = (text: string) => { const found = [...document.querySelectorAll("button")].find(el => el.textContent?.trim() === text); assert.ok(found, `button ${text}`); return found; };
const field = (text: string) => { const label = [...document.querySelectorAll("label")].find(el => el.firstChild?.textContent?.trim() === text); assert.ok(label, `field ${text}`); const input = label.querySelector("input,select,textarea"); assert.ok(input); return input as HTMLInputElement; };
async function click(text: string) { await act(async () => button(text).click()); }
async function fill(label: string, value: string) {
  const input = field(label);
  const prototype = input.tagName === "SELECT" ? dom.window.HTMLSelectElement.prototype : input.tagName === "TEXTAREA" ? dom.window.HTMLTextAreaElement.prototype : dom.window.HTMLInputElement.prototype;
  await act(async () => { Object.getOwnPropertyDescriptor(prototype, "value")!.set!.call(input, value); input.dispatchEvent(new dom.window.Event(input.tagName === "SELECT" ? "change" : "input", { bubbles: true })); });
}
await act(async () => root.render(createElement(CourseEditor, { api, course })));
await click("Spreadsheets (0)");
await click("Add spreadsheet assignment");
assert.equal(button("Save course").disabled, true, "unapplied author edits block course save");
await fill("Assignment title", "Mixed-case budget");
await fill("Attached lesson", "practice");
await fill("Protected cells (comma-separated worksheet!cell references)", "budget!b1, budget!b2");
await fill("Graded cell", "budget!b3");
await fill("Expected result", "750");
await click("Add or replace criterion");
await fill("Starter cell", "H12");
await fill("Starter content", "A cell beyond the first grid");
await click("Set starter cell");
await click("Apply assignment to course");
await click("Save course");
assert.ok(saved);
const first = saved.spreadsheetAssignments![0];
assert.equal(first.title, "Mixed-case budget");
assert.equal(first.lessonId, "practice");
assert.deepEqual(first.protectedCells, ["Budget!B1", "Budget!B2"]);
assert.equal(first.answers["Budget!B3"], 750);
assert.equal(first.starter.sheets.Budget.H12, "A cell beyond the first grid");
const id = first.id;
// Reopen persisted course, edit the same assignment, and retain its progress key.
await act(async () => root.render(createElement(CourseEditor, { key: "reopened", api: { ...api, courses: [saved!] }, course: saved! })));
await click("Spreadsheets (1)");
await click("Edit Mixed-case budget");
await fill("Assignment title", "Reopened budget");
await click("Apply assignment to course");
await click("Save course");
assert.equal(saved!.spreadsheetAssignments![0].id, id);
assert.equal(saved!.spreadsheetAssignments![0].title, "Reopened budget");
await click("Remove Reopened budget");
await click("Keep assignment");
assert.ok(button("Edit Reopened budget"), "cancel remove preserves assignment");
// A deferred save must not mark concurrently edited fields clean or permit navigation.
let resolveSave: (() => void) | undefined;
let saveCalls = 0;
let navigationCalls = 0;
const persistedTitles: string[] = [];
const delayedApi = { ...api, courses: [saved!], go: (target: {name: string; courseId?: string}) => {
  assert.equal(requestNavigation("app", {name: "library"}), false, "Done discard cannot authorize another target");
  assert.equal(requestNavigation("history", target), false, "Done discard cannot authorize browser history");
  if (requestNavigation("app", target)) navigationCalls++;
}, saveCourse: async (value: Course) => {
  saveCalls++;
  persistedTitles.push(value.title);
  if (saveCalls === 1) await new Promise<void>(resolve => { resolveSave = resolve; });
} } as unknown as AppApi;
await act(async () => root.render(createElement(CourseEditor, { key: "deferred-save", api: delayedApi, course: saved! })));
assert.equal(requestNavigation(), true, "clean official editor permits navigation");
await fill("Title", "First saved snapshot");
assert.equal(requestNavigation(), false, "dirty official editor vetoes global navigation");
await click("Save course");
assert.equal(saveCalls, 1);
assert.equal(requestNavigation("history"), false, "pending save vetoes browser navigation");
await act(async () => { window.dispatchEvent(new dom.window.KeyboardEvent("keydown", { key: "s", ctrlKey: true, bubbles: true })); });
assert.equal(saveCalls, 1, "repeated save shortcut cannot start overlapping persistence");
await fill("Title", "New edit during save");
await click("← Done");
assert.equal(navigationCalls, 0, "Done waits for in-flight persistence");
assert.equal(button("Save course").disabled, true);
await act(async () => { resolveSave!(); });
assert.ok(document.querySelector(".dirty-dot"), "save completion leaves concurrent edits dirty");
assert.equal(button("Save course").disabled, false);
assert.equal(field("Title").value, "New edit during save");
await click("Save course");
assert.deepEqual(persistedTitles, ["First saved snapshot", "New edit during save"]);
assert.equal(document.querySelector(".dirty-dot"), null, "second save persists the newer snapshot");
assert.equal(requestNavigation(), true, "latest persisted draft permits navigation");
await fill("Title", "Explicit discard only");
let confirmations = 0;
window.confirm = () => { confirmations++; return true; };
await click("← Done");
assert.equal(confirmations, 1, "Done asks once before intentional discard");
assert.equal(navigationCalls, 1, "confirmed discard permits its exact course destination");
assert.equal(requestNavigation("app", {name: "course", courseId: saved!.id}), false, "discard permission is not retained");
// Review is explicit and bound to exact bytes, not a reusable approval toggle.
const reviewCourse = saved!;
await act(async () => root.render(createElement(SpreadsheetReviewPanel, { course: reviewCourse })));
assert.equal(button("Prepare review record").disabled, true);
await fill("Reviewer", "Instructor test");
await act(async () => document.querySelector<HTMLInputElement>('input[type="checkbox"]')!.click());
await click("Prepare review record");
const record = field("Review record JSON") as unknown as HTMLTextAreaElement;
const approval = JSON.parse(record.value);
assert.deepEqual(await validateSpreadsheetReleaseApproval(reviewCourse, approval), []);
const snapshot = document.querySelector<HTMLTextAreaElement>('textarea[aria-label="Reviewed course snapshot JSON"]')!.value;
assert.equal(snapshot, exportCourseSnapshot(reviewCourse));
await act(async () => root.render(createElement(SpreadsheetReviewPanel, { course: { ...reviewCourse, title: "Changed after review" } })));
assert.equal(document.querySelector('textarea[aria-label="Reviewed course snapshot JSON"]'), null, "course edits invalidate visible receipt and snapshot");
assert.equal(button("Prepare review record").disabled, true, "new snapshot needs new explicit acknowledgement");
await act(async () => root.unmount());
dom.window.close();
console.log("spreadsheet authoring UI: create, canonical references, attach, save/reopen, stable edit, cancel removal, deferred-save recovery and snapshot review passed");
