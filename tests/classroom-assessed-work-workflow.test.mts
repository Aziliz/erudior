import assert from 'node:assert/strict';
import { classFile, verifyHandIn, makeHandIn } from '../src/lib/classroom.ts';
import { preparePersistedHandIn } from '../src/lib/classroomExport.ts';
import { createAssessedWorkSubmission, appendAssessedWorkSubmission } from '../src/lib/assessedWorkEvidence.ts';
import { prepareAssessedWorkSubmission, beginAssessedWorkSubmissionSave, failAssessedWorkSubmissionSave, confirmAssessedWorkSubmissionSave } from '../src/lib/assessedWorkSubmissionState.ts';
import { createClassroomSubmissionStore, type ClassroomSubmissionIO } from '../src/lib/classroomSubmissionStore.ts';
import { newClass, newStudent, type Family } from '../src/lib/family.ts';
import { emptyProgress } from '../src/lib/storage.ts';
const learner=newStudent('Learner',7),other=newStudent('Other',7),cls=newClass('Class',[learner.id,other.id]);
cls.assignments=[{courseId:'science',assigned:'2026-10-28'}];
const family={format:'erudior-family',version:1,mode:'classroom',students:[learner,other],classes:[cls]} as Family;
const joined={cls:classFile(family,cls,()=> 'Science'),studentId:learner.id};
const when='2026-10-28T12:00:00Z';
const rubric={id:'rubric',criteria:[{id:'reason',name:'Reasoning',levels:[{points:2,label:'Supported'},{points:0,label:'Revise'}]}]};
const task={id:'essay',title:'Observation',kind:'short' as const,prompt:'Explain your original observation',rubric:'rubric'};
const photo={id:'photo1',fileId:'file1',name:'evidence.txt',mime:'text/plain',bytes:3,caption:'Original evidence',date:'2026-10-28'};
const first=createAssessedWorkSubmission({id:'first',submittedAt:Date.parse(when),courseId:'science',assignmentId:'essay',kind:'writing',task,rubric,response:{kind:'writing',started:when,updated:when,submitted:when,rounds:1,text:'Original answer',photos:[photo]},files:{file1:{mime:'text/plain',data:'AQID'}}});
const foreign=createAssessedWorkSubmission({...first,id:'foreign',courseId:'unassigned'});
let persisted=emptyProgress();persisted.assessedWorkSubmissions=appendAssessedWorkSubmission(appendAssessedWorkSubmission({},first),foreign);
let active:string|null=learner.id;
const exportIO={activeStudent:()=>active,loadProgress:async()=>structuredClone(persisted),loadFile:async()=>{throw Error('Historical files must come from exact captured evidence');}};
persisted.work={'science/essay':first.response as any};
prepareAssessedWorkSubmission(learner.id,first);beginAssessedWorkSubmissionSave(learner.id,first);failAssessedWorkSubmissionSave(learner.id,first);
const pendingHandin=await preparePersistedHandIn(joined,{...exportIO,loadFile:async()=>({mime:'text/plain',data:'AQID'})});
assert.deepEqual(pendingHandin.progress.assessedWorkSubmissions,{},'unconfirmed history withheld');
assert.deepEqual(pendingHandin.progress.work,{},'unconfirmed legacy projection withheld too');
delete persisted.work; // Historical receipt files remain self-contained, without current-file projection.
beginAssessedWorkSubmissionSave(learner.id,first);confirmAssessedWorkSubmissionSave(learner.id,first);
const handin=await preparePersistedHandIn(joined,exportIO);assert.deepEqual(Object.keys(handin.progress.assessedWorkSubmissions!),['first']);await verifyHandIn(handin,family);
active=other.id;await assert.rejects(preparePersistedHandIn(joined,exportIO),/another learner/);active=learner.id;
await assert.rejects(preparePersistedHandIn(joined,{...exportIO,loadProgress:async()=>{active=other.id;return persisted;}}),/changed/);active=learner.id;
const state=new Map<string,string>([['family',JSON.stringify(family)]]);
const io:ClassroomSubmissionIO={readState:async k=>state.get(k)??null,writeState:async(k,v)=>{state.set(k,v);},updateState:async(k,fn)=>{const text=await fn(state.get(k)??null);state.set(k,text);return text;},readFamily:async()=>JSON.parse(state.get('family')!),writeFamily:async f=>{state.set('family',JSON.stringify(f));},readFile:async()=>null,writeFile:async()=>{},now:()=>when};
let teacher=createClassroomSubmissionStore(io);const received=await teacher.import(handin,family);const exact=JSON.stringify(received.record.snapshot);
const assessment={version:1 as const,workSubmissionId:'first',levels:{reason:2}};
await teacher.review({submissionId:received.record.id,eventId:'review1',status:'reviewed',reviewedAt:when,note:'Original response reviewed',assessment},family);
await teacher.review({submissionId:received.record.id,eventId:'review1',status:'reviewed',reviewedAt:when,note:'Original response reviewed',assessment},family);
const second=createAssessedWorkSubmission({...first,id:'second',task:{...task,prompt:'A changed prompt'},rubric:{...rubric,criteria:[{...rubric.criteria[0],levels:[{points:5,label:'New scale'},{points:0,label:'Revise'}]}]}});
persisted.assessedWorkSubmissions=appendAssessedWorkSubmission(persisted.assessedWorkSubmissions!,second);
await teacher.import(await preparePersistedHandIn(joined,exportIO),family);await teacher.import(handin,family);
teacher=createClassroomSubmissionStore(io);const records=await teacher.load(),previous=records.find(r=>r.id===received.record.id)!;
assert.equal(records.length,2);assert.equal(JSON.stringify(previous.snapshot),exact);assert.equal(previous.reviewEvents.length,1);assert.deepEqual(previous.reviewEvents[0].assessment,assessment);
assert.equal(previous.status,'pending','item rubric review does not silently approve whole receipt');
const projected=JSON.parse(state.get(`progress-${learner.id}`)!);assert.deepEqual(Object.keys(projected.assessedWorkSubmissions).sort(),['first','second']);
assert.equal(projected.assessedWorkSubmissions.first.files.file1.data,'AQID');assert.equal(state.has(`records-${learner.id}`),false,'no automatic academic grades');assert.equal(state.has(`progress-${other.id}`),false);
const conflict={...emptyProgress(),assessedWorkSubmissions:{first:createAssessedWorkSubmission({...first,response:{...first.response as any,text:'Rewritten under same ID'}})}};
await assert.rejects(teacher.import(await makeHandIn(joined.cls,learner.id,conflict),family),/Conflicting/);
console.log('assessed-work classroom lifecycle: confirmed-only signed export, course/profile scope, original task/rubric/files, exact human review, revision history, replay and grade separation passed');
