import assert from "node:assert/strict";
import { createAssessedWorkSubmission } from "../src/lib/assessedWorkEvidence.ts";
import { assessedReviewScore, parseSubmissionHistory, recordHandIn, reviewHandIn, validateSubmissionAssessment, type SubmissionAssessment } from "../src/lib/submissionHistory.ts";
import { classFile, makeHandIn } from "../src/lib/classroom.ts";
import { newClass, newStudent, type Family } from "../src/lib/family.ts";
import { emptyProgress } from "../src/lib/storage.ts";
const when="2026-10-28T15:00:00Z", submittedAt=Date.parse(when);
const rubric={id:"rubric",title:"Original rubric",criteria:[{id:"reasoning",name:"Reasoning",levels:[{points:2.5,label:"Clear"},{points:0,label:"Revise"}]},{id:"evidence",name:"Evidence",levels:[{points:4,label:"Supported"},{points:1,label:"Developing"}]}]};
const entry=createAssessedWorkSubmission({id:"work1",submittedAt,courseId:"science",assignmentId:"essay",kind:"writing",task:{id:"essay",title:"Original essay",kind:"short",prompt:"Explain the original observation",rubric:"rubric"},rubric,response:{kind:"writing",started:when,updated:when,submitted:when,rounds:1,text:"Original student answer"},files:{}});
const child=newStudent("Learner",7),cls=newClass("Class",[child.id]);cls.assignments=[{courseId:"science",assigned:"2026-10-28"}];
const family={format:"erudior-family",version:1,mode:"classroom",students:[child],classes:[cls]} as Family;
const progress=emptyProgress();progress.assessedWorkSubmissions={work1:entry};
const handin=await makeHandIn(classFile(family,cls,()=>"Science"),child.id,progress);
const initial=recordHandIn([],handin,when).records,id=initial[0].id;
const full:SubmissionAssessment={version:1,workSubmissionId:"work1",levels:{reasoning:2.5,evidence:4},criterionNotes:{reasoning:"Teacher explanation"}};
const reviewed=reviewHandIn(initial,id,"reviewed",when,"Human feedback","assessment1",full);
assert.equal(reviewed[0].status,"pending","item review never promotes whole receipt");
assert.equal(reviewed[0].reviewEvents.length,1);
assert.deepEqual(assessedReviewScore(entry,full),{points:6.5,outOf:6.5,percent:100});
assert.deepEqual(reviewHandIn(reviewed,id,"reviewed",when,"Human feedback","assessment1",full),reviewed,"same event retry is idempotent");
assert.throws(()=>reviewHandIn(reviewed,id,"needs_revision",when,"Changed","assessment1",full),/different decision/);
const revision=reviewHandIn(reviewed,id,"needs_revision",when,"Revise reasoning","assessment2",{version:1,workSubmissionId:"work1",levels:{reasoning:0}});
assert.equal(revision[0].reviewEvents.length,2);assert.equal(revision[0].reviewEvents[0].assessment!.levels.reasoning,2.5);
assert.deepEqual(parseSubmissionHistory(JSON.parse(JSON.stringify(revision))),revision);
for(const bad of [{...full,workSubmissionId:"other"},{...full,version:2},{...full,levels:{reasoning:2,evidence:4}},{...full,levels:{reasoning:"2.5",evidence:4}},{...full,levels:{reasoning:NaN,evidence:4}},{...full,levels:{reasoning:2.5,evidence:4,unknown:1}},{...full,levels:{reasoning:2.5}},{...full,criterionNotes:{unknown:"not original"}},{...full,academicGrade:100}])
 assert.throws(()=>reviewHandIn(initial,id,"reviewed",when,"","bad",bad as never));
assert.throws(()=>validateSubmissionAssessment({...handin,progress:{...handin.progress,assessedWorkSubmissions:{work1:{...entry,rubric:{...rubric,criteria:[rubric.criteria[0],rubric.criteria[0]]}}}}},full,"reviewed"),/Ambiguous/);
const general=reviewHandIn(revision,id,"reviewed",when,"Receipt examined","general");
assert.equal(general[0].status,"reviewed");assert.equal(general[0].reviewEvents.at(-1)!.assessment,undefined);
const laterItem=reviewHandIn(general,id,"needs_revision",when,"Item still needs work","item3",{version:1,workSubmissionId:"work1",levels:{}});
assert.equal(laterItem[0].reviewNote,"Receipt examined","legacy receipt-wide summaries remain backward compatible");
assert.equal(initial[0].snapshot.progress.assessedWorkSubmissions!.work1.response && (initial[0].snapshot.progress.assessedWorkSubmissions!.work1.response as any).text,"Original student answer");
assert.equal(assessedReviewScore({...entry,rubric:undefined},full),null,"missing original rubric never invents score");
const otherHandin=await makeHandIn(classFile(family,cls,()=>"Science"),child.id,emptyProgress());
const otherRecord=recordHandIn(initial,otherHandin,"2026-10-28T16:00:00Z").records.find(r=>r.id!==id)!;
assert.throws(()=>reviewHandIn([otherRecord],otherRecord.id,"reviewed",when,"","foreign",full),/exact hand-in/);
console.log("assessed work review: original rubric binding, exact fractional levels, unknown rejection, append-only retry, receipt status separation and legacy compatibility passed");
