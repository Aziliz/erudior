import assert from 'node:assert/strict';
import { fixture } from './branching-engine.test.mts';
import { createBranchingEngineStore, deleteBranchingStudent } from '../src/lib/branchingEngineStore.ts';
import { parseBranchingLibrary } from '../src/lib/branchingEngine.ts';
let text:string|null=null, profile='alice', authority='unlocked', tick=0;
let queue=Promise.resolve();
const update=async(change:(s:string|null)=>Promise<string>)=>{let result='';const work=queue.then(async()=>{result=await change(text);text=result;});queue=work.catch(()=>{});await work;return result;};
const io={read:async()=>text,update,authorizeAdult:async(id?:string)=>{if(id&&!['alice','bob'].includes(id))throw Error('Unknown learner');return {actorId:'adult',actorName:'Teacher',authorityKey:authority};},learnerContext:async()=>({studentId:profile,authorityKey:'profile:'+profile}),now:()=>new Date(Date.UTC(2026,9,29,0,0,tick++)).toISOString()};
const {supervisor,learner}=createBranchingEngineStore(io);
const first=await supervisor.savePack(fixture,null);assert.equal(first.revision,1);assert(!first.approval);assert.deepEqual(await supervisor.savePack(fixture,null),first);
const input={id:'case',studentId:'alice',title:'Fictional project',instructions:'Use fictional data.',startTick:0,pack:first};
await assert.rejects(supervisor.assign(input,null),/approved/);
const approved=await supervisor.approvePack(first.id,1);assert.deepEqual(await supervisor.approvePack(first.id,1),approved);assert.equal((await supervisor.load()).packReviews.length,1);
const assigned=await supervisor.assign({...input,pack:approved},null);assert.deepEqual(await supervisor.assign({...input,pack:approved},null),assigned);
const command={kind:'choice' as const,choiceId:'prepare',note:'Prepare project'};
const session=await learner.command('case',1,command,'event1',null);assert.equal(session.revision,1);assert.deepEqual(await learner.command('case',1,command,'event1',null),session);
await assert.rejects(learner.command('case',1,{...command,note:'Changed'},'event1',1),/identity/);
const evidence=await learner.submit('case',1,'submission',1);assert.deepEqual(await learner.submit('case',1,'submission',1),evidence);
const feedback=await supervisor.review({id:'review',submissionId:'submission',status:'needs_revision',note:'Explain consequences'});assert.deepEqual(await supervisor.review({id:'review',submissionId:'submission',status:'needs_revision',note:'Explain consequences'}),feedback);
await assert.rejects(supervisor.review({id:'review',submissionId:'submission',status:'reviewed',note:'Changed'}),/identity/);
await supervisor.savePack({...approved,title:'Unassigned private source'},1);assert.equal((await learner.load()).packs.length,1);
profile='bob';const other=await learner.load();assert.equal(other.assignments.length,0);assert.equal(other.submissions.length,0);assert.equal(other.packReviews.length,0);await assert.rejects(learner.command('case',1,command,'other',1),/belongs/);profile='alice';
const approved2=await supervisor.approvePack(first.id,2);await supervisor.assign({...input,pack:approved2},1);await assert.rejects(learner.command('case',1,command,'stale',1),/changed/);assert.deepEqual((await supervisor.load()).submissions[0],evidence);
const races=await Promise.allSettled([learner.command('case',2,command,'concurrent1',null),learner.command('case',2,{kind:'advance',tick:3,note:'Concurrent clock'},'concurrent2',null)]);assert.equal(races.filter(x=>x.status==='fulfilled').length,1);
const before=text;const changedAdult=createBranchingEngineStore({...io,update:async(change:any)=>{authority='changed';return update(change);}});await assert.rejects(changedAdult.supervisor.savePack({...fixture,id:'new'},null),/authority changed/);assert.equal(text,before);
const changedProfile=createBranchingEngineStore({...io,update:async(change:any)=>{profile='bob';return update(change);}});profile='alice';await assert.rejects(changedProfile.learner.command('case',2,{kind:'advance',tick:5,note:'Race'},'race',1),/profile changed/);assert.equal(text,before);profile='alice';
const restored=parseBranchingLibrary(text);restored.pendingApproval=restored.packs.map(p=>`${p.id}@${p.revision}`);restored.restoredAt=io.now();text=JSON.stringify(restored);await assert.rejects(learner.command('case',2,{kind:'advance',tick:5,note:'Quarantine'},'restore',1),/fresh adult review/);
const assignedSnapshot=structuredClone(restored.assignments);const receipts=restored.packReviews.length;await supervisor.approvePack(first.id,2);assert.equal((await supervisor.load()).packReviews.length,receipts+1);assert.deepEqual((await supervisor.load()).assignments,assignedSnapshot);assert.deepEqual((await supervisor.load()).submissions[0],evidence);
let deleted=false;const deletionRace=createBranchingEngineStore({...io,update:async change=>{if(!deleted){deleted=true;text=JSON.stringify(deleteBranchingStudent(parseBranchingLibrary(text),'alice'));}return update(change);}});await assert.rejects(deletionRace.learner.command('case',2,{kind:'advance',tick:5,note:'Delete race'},'delete',1),/deleted/);const removed=parseBranchingLibrary(text);assert.equal(removed.assignments.length,0);assert.equal(removed.sessions.length,0);assert.equal(removed.submissions.length,0);assert.equal(removed.feedback.length,0);assert.deepEqual(deleteBranchingStudent(removed,'alice'),removed);await assert.rejects(learner.load(),/deleted/);await assert.rejects(supervisor.assign({...input,id:'resurrect',pack:approved2},null),/deleted/);
let freshText:string|null=null;profile='bob';const fresh=createBranchingEngineStore({...io,read:async()=>freshText,update:async c=>freshText=await c(freshText)});await fresh.supervisor.savePack(fixture,null);const freshPack=await fresh.supervisor.approvePack(fixture.id,1);await fresh.supervisor.assign({...input,id:'fresh',studentId:'bob',pack:freshPack},null);const checkpoint=await fresh.learner.submit('fresh',1,'untouched',null);assert.deepEqual(await fresh.learner.submit('fresh',1,'untouched',null),checkpoint);
console.log('Branching store: exact approval, immutable source/history, retries, concurrent CAS, fresh profile/credential checks, quarantine review provenance and deletion passed');
await fresh.learner.command('fresh',1,command,'after-empty',null);assert.deepEqual(await fresh.learner.submit('fresh',1,'untouched',null),checkpoint,'interrupted retry returns original evidence even after later practice');await assert.rejects(fresh.learner.submit('fresh',1,'untouched',1),/identity/);
