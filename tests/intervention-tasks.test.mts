course.modules=[{id:'m',title:'Module'}];course.lessons=[...new Set(FOUNDATION_COMPETENCIES.flatMap(s=>s.lessons[course.id]??[]))].map(id=>({id,module:'m',title:id,body:'Study',quiz:id==='pre-place-value'?['q']:[]}));
