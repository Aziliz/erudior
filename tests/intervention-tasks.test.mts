await assert.rejects(raced.prepare(task,activities[0]),/withdrawn|changed/);
state=JSON.stringify(saved);let reads=0;const revised=createInterventionTaskAccess({...io,readCourses:async()=>++reads===1?[course]:[{...course,lessons:course.lessons.map(l=>({...l,body:'changed'}))}]});await assert.rejects(revised.prepare(task,activities[0]),/changed|unavailable/);
