import assert from 'node:assert/strict';
import { emptyCourse } from '../src/lib/course.ts';
import { presentationSources, parsePresentation, parsePresentationLibrary, presentationProblems, makeVideoSlide, safePresentationVideoUrl, type PresentationDeck, type QuestionSlide } from '../src/lib/presentations.ts';
const c=emptyCourse('Synthetic source');c.id='source';c.revision=2;
c.lessons=[{id:'lesson',module:'module',title:'Readable lesson',body:'A complete text slide.'},{id:'media',module:'module',title:'Unsupported media',body:'![image](https://media.org/image.png)'}];
c.decks=[{id:'cards',title:'Cards',cards:[{id:'one',front:'Term',back:'Definition'}]}];c.glossary=[{term:'word',definition:'Meaning'}];
c.banks=[{id:'bank',title:'Bank',questions:[{id:'q',stem:'Which?',choices:['A','B'],answer:[1],topic:'Topic'},{id:'q2',stem:'Listen?',choices:['A','B'],answer:[0],topic:'Topic',listen:'sound'}]}];
const original=JSON.stringify(c),pool=presentationSources([c]);assert.equal(pool.slides.length,4);assert.equal(pool.excluded,2);assert.equal(JSON.stringify(c),original);
const deck:PresentationDeck={format:'erudior-presentation',version:1,id:'deck',title:'Teaching deck',revision:0,slides:pool.slides};
assert.deepEqual(parsePresentation(JSON.stringify(deck)),deck);assert.deepEqual(presentationProblems(deck,[c]),[]);
const question=pool.slides.find(x=>x.kind==='question') as QuestionSlide;
const video=makeVideoSlide(question,'https://media.school.org/clip.mp4','Accessible video transcript',12.5);
assert.equal(video.kind,'video');assert.deepEqual(presentationProblems({...deck,slides:[video]},[c]),[]);
for(const url of ['http://school.org/clip.mp4','javascript:alert(1)','data:video/mp4,AAAA','https://u:p@school.org/x','https://localhost/x','https://127.0.0.1/x','https://2130706433/x','https://[::1]/x','https://host.local/x','https://host.internal/x','https://school.org:8443/x','https://school.org/x#fragment'])assert.equal(safePresentationVideoUrl(url),false,url);
assert.equal(safePresentationVideoUrl('https://media.school.org/clip.mp4?version=1'),true);
for(const patch of [{version:2},{revision:-1},{slides:[...deck.slides,deck.slides[0]]},{slides:[{...question,answer:[9]}]},{slides:[{...question,choices:['A']}]},{slides:[{...video,transcript:''}]},{slides:[{...video,pauseAt:NaN}]},{slides:[{...video,pauseAt:14401}]},{slides:[{...question,secret:'unexpected'}]},{slides:[{...question,source:{...question.source,answer:[1]}}]}])assert.throws(()=>parsePresentation({...deck,...patch}));
assert.throws(()=>parsePresentationLibrary({format:'erudior-presentation-library',version:1,decks:[deck,deck]}));
assert.throws(()=>parsePresentationLibrary('{damaged'));
assert.equal(presentationProblems({...deck,slides:[]},[c]).length,1);
assert.equal(presentationProblems(deck,[]).length,4);
assert.equal(presentationProblems(deck,[{...c,revision:3}]).length,4);
const altered=structuredClone(c);altered.banks[0].questions[0].answer=[0];assert.equal(presentationProblems(deck,[altered]).length,1);
const duplicate=structuredClone(c);duplicate.banks[0].questions.push({...duplicate.banks[0].questions[0],image:{src:'x',alt:'x'}} as any);assert(!presentationSources([duplicate]).slides.some(s=>s.source.kind==='question'),'ambiguous identity excluded even if second copy unsupported');
assert.equal(presentationSources([c,c]).slides.length,0);
const forged=structuredClone(deck);(forged.slides.find(s=>s.kind==='question') as QuestionSlide).answer=[0];assert.equal(presentationProblems(forged,[c]).length,1);
console.log('presentations: strict format, source eligibility/exactness, stale revisions, ambiguous identity, safe video/transcript and tampering checks passed');
