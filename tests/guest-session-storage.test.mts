let persistentReads = 0;
for (const name of ["indexedDB", "localStorage", "sessionStorage"]) {
  Object.defineProperty(globalThis, name, { configurable: true, get() {
    persistentReads++;
    throw Error(`Temporary learning must not inspect ${name}`);
  } });
}
