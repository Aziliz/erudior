import assert from 'node:assert/strict';
import {appendInterventionPlan,appendInterventionEvent,emptyInterventionState,parseInterventionState,interventionActivities,validateInterventionActivities,compareIntervention,interventionReport,interventionStatus,type InterventionPlan} from '../src/lib/interventions.ts';
import type {SkillDiagnostic} from '../src/lib/learningDiagnostics.ts';
import type {Course} from '../src/lib/types.ts';
import type {AuthoredCompetency} from '../src/lib/competencyCatalog.ts';
const course={id:'fixture',revision:1,lessons:[{id:'lesson',title:'Lesson',body:'Read',topics:[],quiz:['linked']}],banks:[{id:'fixture__bank',courseId:'fixture',questions:[{id:'linked',stem:'Linked',topic:'Shared',choices:['A','B'],answer:[0]}]}]} as Course;
const authored:AuthoredCompetency[]=[{id:'fixture.skill',title:'Skill',prerequisites:[],evidence:{},lessons:{fixture:['lesson']}}];
const activities=await interventionActivities([course],'fixture.skill',authored);
assert.equal(activities.length,2);await validateInterventionActivities([course],'fixture.skill',activities,authored);
const changed=structuredClone(course);changed.lessons[0].body='Changed';
await assert.rejects(validateInterventionActivities([changed],'fixture.skill',[activities[0]],authored),/source changed/);
await assert.rejects(validateInterventionActivities([course],'fixture.skill',[activities[0],activities[0]],authored));
const base:SkillDiagnostic={skillId:'fixture.skill',title:'Skill',mastery:.2,confidence:.5,answers:2,status:'insufficient',reason:'Limited evidence.',blockedBy:[],patterns:[],measuredAt:'2026-10-02T00:00:00Z',sources:[{skillId:'fixture.skill',courseId:'fixture',bankId:'fixture__bank',questionId:'linked',fingerprint:'a'.repeat(64),revision:1,since:'2026-10-01T00:00:00Z',baselineSeen:0,baselineCorrect:0,n:2,mastery:.2,confidence:.5,snapshotId:'b'.repeat(64),at:'2026-10-02T00:00:00Z',latestAttemptAt:'2026-10-02T00:00:00Z'}]};
const plan:InterventionPlan={id:'plan',studentId:'alice',skillId:'fixture.skill',goal:'Review skill',instructions:'Review together, then practice independently.',activities,baseline:base,actorId:'adult',actorName:'Teacher',createdAt:'2026-10-02T00:00:00Z'};
let state=appendInterventionPlan(emptyInterventionState(),plan);
assert.deepEqual(appendInterventionPlan(state,plan),state);assert.throws(()=>appendInterventionPlan(state,{...plan,goal:'Conflict'}));
assert.throws(()=>parseInterventionState({...state,deletedStudentIds:['alice']}));
assert.throws(()=>parseInterventionState({...state,admin:true}));
assert.throws(()=>parseInterventionState({...state,plans:[{...plan,createdAt:'2026-02-30T00:00:00Z'}]}));
assert.throws(()=>parseInterventionState({...state,plans:[{...plan,activities:[activities[0],activities[0]]}]}));
assert.throws(()=>parseInterventionState({...state,plans:[{...plan,baseline:{...base,confidence:2}}]}));
const observation={id:'observation',planId:'plan',kind:'observation' as const,note:'Learner explained the first step with a prompt.',actorId:'adult',actorName:'Teacher',at:'2026-10-03T00:00:00Z'};
state=appendInterventionEvent(state,observation);assert.deepEqual(appendInterventionEvent(state,observation),state);
assert.equal(compareIntervention(plan,base).comparable,false);
assert.throws(()=>appendInterventionEvent(state,{...observation,id:'earlier',at:'2026-10-02T12:00:00Z'}),'append order cannot falsify chronology');
const next=structuredClone(base);next.mastery=.6;next.sources[0]={...next.sources[0],n:3,mastery:.6,snapshotId:'c'.repeat(64),at:'2026-10-04T00:00:00Z',latestAttemptAt:'2026-10-04T00:00:00Z'};
assert.equal(compareIntervention(plan,next).comparable,true);assert(Math.abs(compareIntervention(plan,next).delta!-.4)<1e-9);
const changedLineage=structuredClone(next);changedLineage.sources[0].fingerprint='d'.repeat(64);assert.equal(compareIntervention(plan,changedLineage).comparable,false);
const undated=structuredClone(next);delete undated.sources[0].latestAttemptAt;assert.equal(compareIntervention(plan,undated).newEvidence,false,'a capture timestamp alone is not new assessment evidence');
const reset=structuredClone(next);reset.sources[0].n=1;assert.equal(compareIntervention(plan,reset).comparable,false);
state=appendInterventionEvent(state,{...observation,id:'review',kind:'review',action:'complete',evidence:next,at:'2026-10-04T00:00:00Z'});
assert.equal(interventionStatus(state,'plan'),'complete');assert.throws(()=>appendInterventionEvent(state,{...observation,id:'late',at:'2026-10-05T00:00:00Z'}));
state=appendInterventionPlan(state,{...plan,id:'bobplan',studentId:'bob',instructions:'PRIVATE BOB'});
const report=interventionReport(state,'alice','Alice',[next]);assert(!report.includes('PRIVATE BOB'));assert.match(report,/Not a clinical diagnosis/);assert.match(report,/Learner explained/);
const noPlanReport=interventionReport(emptyInterventionState(),'alice','Alice',[base]);
assert.match(noPlanReport,/Current educational evidence/);assert.match(noPlanReport,/2 linked answers/);assert.match(noPlanReport,/confidence 50%/);assert.match(noPlanReport,/2026-10-02/);assert(noPlanReport.includes('a'.repeat(64)));assert.match(noPlanReport,/No targeted support plans/);
const noEvidenceReport=interventionReport(emptyInterventionState(),'alice','Alice');assert.match(noEvidenceReport,/Absence of evidence is not a demonstrated misconception/);
assert(!report.includes('bobplan'));assert(!report.includes('PRIVATE BOB'));
assert.throws(()=>interventionReport(state,'alice','Alice',[base,base]),/Invalid learner diagnostic/);
assert.deepEqual(parseInterventionState(JSON.stringify(state)),state);
console.log('interventions: immutable lifecycle, strict schema, sources, comparisons and private reports passed');
