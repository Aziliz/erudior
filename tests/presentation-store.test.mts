import assert from 'node:assert/strict';
import {createPresentationStore} from '../src/lib/presentationStore.ts';
import {parsePresentationLibrary,type PresentationDeck} from '../src/lib/presentations.ts';
import {validStateName,stateTransactions} from '../src/lib/stateLock.ts';
let text:string|null=null,actor='adult',failWrite=false;
const tx=stateTransactions({read:async()=>text,write:async(_,v)=>{if(failWrite)throw Error('Disk full');text=v;},compareAndSwap:async(_,expected,value)=>{if(failWrite)throw Error('Disk full');if(text!==expected)return false;text=value;return true;}});
const store=createPresentationStore({read:async()=>text,update:f=>tx.update('presentations',f),authorize:async()=>{if(!actor)throw Error('Locked');return actor;}});
const deck:PresentationDeck={format:'erudior-presentation',version:1,id:'one',title:'Teaching',revision:0,slides:[]};
assert(validStateName('presentations'));assert(!validStateName('../presentations'));assert(!validStateName('presentations/other'));
assert.deepEqual((await store.load()).decks,[]);
const first=await store.save(deck,null);assert.equal(first.revision,1);assert.equal(deck.revision,0);
await assert.rejects(store.save(deck,null),/changed elsewhere/);
const both=await Promise.allSettled([store.save({...first,title:'First'},1),store.save({...first,title:'Second'},1)]);assert.equal(both.filter(x=>x.status==='fulfilled').length,1);assert.equal((await store.load()).decks[0].revision,2);
const before=text;failWrite=true;await assert.rejects(store.save({...first,title:'Unsaved draft'},2),/Disk full/);assert.equal(text,before);failWrite=false;
actor='';await assert.rejects(store.load(),/Locked/);await assert.rejects(store.save(first,2),/Locked/);assert.equal(text,before);actor='adult';
let checks=0;const changed=createPresentationStore({read:async()=>text,update:f=>tx.update('presentations',f),authorize:async()=>++checks===1?'adult':'other'});await assert.rejects(changed.save(first,2),/Adult access changed/);assert.equal(text,before);
text='{damaged';await assert.rejects(store.load());await assert.rejects(store.save(deck,null));assert.equal(text,'{damaged');text=before;
await assert.rejects(store.remove('one',1),/changed elsewhere/);await store.remove('one',2);assert.deepEqual(parsePresentationLibrary(text).decks,[]);
console.log('presentation store: serialized CAS, stale edit/delete conflicts, failure preservation, live adult reauthorization and malformed state checks passed');
