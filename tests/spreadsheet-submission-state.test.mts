import assert from "node:assert/strict";
import { SAMPLE_ASSIGNMENT } from "../src/lib/spreadsheetAssignments.ts";
import { createSpreadsheetSubmission, appendSpreadsheetSubmission } from "../src/lib/spreadsheetEvidence.ts";
import { prepareSpreadsheetSubmission, beginSpreadsheetSubmissionSave, failSpreadsheetSubmissionSave, confirmSpreadsheetSubmissionSave, pendingSpreadsheetSubmission, getConfirmedSpreadsheetSubmissions } from "../src/lib/spreadsheetSubmissionState.ts";
const assignment = { ...SAMPLE_ASSIGNMENT, lessonId: "lesson" };
const first = createSpreadsheetSubmission({ id: "first", courseId: "course", lessonId: "lesson", submittedAt: 1, assignment, workbook: assignment.starter });
const second = createSpreadsheetSubmission({ ...first, id: "second", submittedAt: 2 });
assert.deepEqual(prepareSpreadsheetSubmission("a", first), first);
assert.deepEqual(prepareSpreadsheetSubmission("a", second), first, "retry preserves original identity and body");
const optimistic = { spreadsheetSubmissions: appendSpreadsheetSubmission({}, first) };
assert.deepEqual(getConfirmedSpreadsheetSubmissions(optimistic, "a"), {});
assert.equal(Object.keys(getConfirmedSpreadsheetSubmissions(optimistic, "b")).length, 1, "unconfirmed evidence is scoped to its learner");
assert.equal(beginSpreadsheetSubmissionSave("a", first), true);
assert.equal(beginSpreadsheetSubmissionSave("a", first), false, "remount cannot duplicate in-flight write");
confirmSpreadsheetSubmissionSave("b", first);
assert.ok(pendingSpreadsheetSubmission("a", "course", assignment.id));
failSpreadsheetSubmissionSave("a", first);
assert.equal(pendingSpreadsheetSubmission("a", "course", assignment.id)?.saving, false);
assert.deepEqual(getConfirmedSpreadsheetSubmissions(optimistic, "a"), {});
const copy = pendingSpreadsheetSubmission("a", "course", assignment.id)!;
copy.submission.workbook.sheets.Budget.B1 = 9;
assert.notEqual(pendingSpreadsheetSubmission("a", "course", assignment.id)!.submission.workbook.sheets.Budget.B1, 9, "registry returns isolated snapshots");
assert.equal(beginSpreadsheetSubmissionSave("a", first), true);
confirmSpreadsheetSubmissionSave("a", first);
assert.equal(pendingSpreadsheetSubmission("a", "course", assignment.id), undefined);
assert.deepEqual(getConfirmedSpreadsheetSubmissions(optimistic, "a"), optimistic.spreadsheetSubmissions);
console.log("spreadsheet submission registry: exact retries, isolation, duplicate-save prevention and confirmed-only exports passed");
