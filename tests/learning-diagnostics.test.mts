import assert from 'node:assert/strict';
import {diagnoseLearning,groupDiagnostics} from '../src/lib/learningDiagnostics.ts';
import {captureCompetencyEvidence,syncCompetencyLedger} from '../src/lib/competencyState.ts';
import {resolveCompetencyEvidence} from '../src/lib/competencyEvidence.ts';
import type {Course,Progress,Attempt} from '../src/lib/types.ts';
import type {AuthoredCompetency} from '../src/lib/competencyCatalog.ts';
const course={id:'fixture',title:'Fixture',revision:1,lessons:[{id:'lesson',title:'Lesson',body:'Read',topics:[],quiz:['linked']}],banks:[{id:'fixture__bank',courseId:'fixture',title:'Bank',questions:[{id:'linked',stem:'Linked',topic:'Shared',choices:['A','B'],answer:[0]},{id:'unrelated',stem:'Noise',topic:'Shared',choices:['A','B'],answer:[0]}]}]} as Course;
const authored:AuthoredCompetency[]=[{id:'fixture.skill',title:'Skill',prerequisites:[],evidence:{},lessons:{fixture:['lesson']}}];
const graph=resolveCompetencyEvidence(authored,[course]);
let p={attempts:[],stats:{},lessonsDone:{}} as Progress;
const raw=JSON.stringify(p);
assert.equal((await diagnoseLearning([course],p,'2026-10-01T00:00:00Z',authored)).skills[0].status,'unknown');
assert.equal(JSON.stringify(p),raw,'projection is pure');
p=syncCompetencyLedger(p,await captureCompetencyEvidence(graph,[course],p,'2026-10-01T00:00:00Z'));
const attempt=(id:string,qid:string,at:string):Attempt=>({id,bankId:'fixture__bank',bankTitle:'Bank',mode:'practice',startedAt:at,finishedAt:at,durationSec:1,total:1,answered:1,correct:0,byTopic:{},bySection:{},answers:[{qid,correct:false,chosen:[1]}]});
p.attempts=[attempt('old','linked','2026-09-01T00:00:00Z'),attempt('a','linked','2026-10-02T00:00:00Z'),attempt('b','linked','2026-10-03T00:00:00Z'),attempt('noise','unrelated','2026-10-03T00:00:00Z')];
p.attempts.push(p.attempts[1]);
let d=await diagnoseLearning([course],p,'2026-10-04T00:00:00Z',authored);
assert.equal(d.skills[0].patterns.length,1);assert.equal(d.skills[0].patterns[0].answered,2);assert.equal(d.skills[0].patterns[0].incorrect,2);
assert.match(d.skills[0].patterns[0].reason,/does not establish why/);
assert.equal(d.skills[0].sources[0].latestAttemptAt,'2026-10-03T00:00:00Z');
assert.equal(d.skills[0].answers,2,'duplicate/prebaseline/unlinked evidence excluded');
const groups=groupDiagnostics([{studentId:'a',studentName:'Alice',diagnostics:d},{studentId:'b',studentName:'Bob',diagnostics:d}]);
assert.deepEqual(groups[0].studentIds,['a','b']);assert.match(groups[0].reason,/insufficient|review/i);
assert.throws(()=>groupDiagnostics([{studentId:'a',studentName:'A',diagnostics:d},{studentId:'a',studentName:'A',diagnostics:d}]));
const changed=structuredClone(course);changed.banks[0].questions[0].answer=[1];
d=await diagnoseLearning([changed],p,'2026-10-04T00:00:00Z',authored);
assert.equal(d.skills[0].mastery,null);assert.equal(d.skills[0].patterns.length,0,'changed semantics invalidate old misconception candidates even same revision');
console.log('learning diagnostics: provenance, uncertainty, groups and semantic changes passed');
