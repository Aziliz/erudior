import assert from 'node:assert/strict';
import { readFileSync } from 'node:fs';
import React from 'react';
import { renderToStaticMarkup } from 'react-dom/server';
import CommunityAuthorGuide from '../src/components/CommunityAuthorGuide';
import { AUTHOR_GUIDE_EXAMPLES as examples, AUTHOR_GUIDE_SECTIONS, authorGuideMarkdown, searchAuthorGuide } from '../src/lib/communityAuthorGuide';
import { checkDoc, emptyDoc, toCourse, migrateCommunityDocToCanonical } from '../src/lib/communityFormat';
import { validateLessonSource } from '../src/lib/lessonSource';
assert.equal(new Set(AUTHOR_GUIDE_SECTIONS.map(s=>s.id)).size,AUTHOR_GUIDE_SECTIONS.length);
assert.equal(searchAuthorGuide('   ').length,AUTHOR_GUIDE_SECTIONS.length);
assert(searchAuthorGuide('ALT TEXT').some(s=>s.id==='media'));
assert(searchAuthorGuide('save canonical').some(s=>s.id==='save'));
assert.equal(searchAuthorGuide('<script>alert(1)</script>').length,0);
assert.equal(searchAuthorGuide('missing-search-term-123').length,0);
assert.equal(readFileSync(new URL('../docs/COMMUNITY_AUTHOR_GUIDE.md',import.meta.url),'utf8'),authorGuideMarkdown(),'Repository guide must match in-editor source');
const doc=emptyDoc('Original guide examples');doc.description='Synthetic walkthrough examples, not an actual course.';
doc.lessons[0].blocks=[{type:'heading',text:'Compare shapes'},{type:'text',md:examples.markdown},{type:'math',tex:examples.formula},{type:'diagram',code:examples.diagram,title:'Observation cycle',description:'Observe, then compare, then explain.'},{type:'manipulative',spec:{kind:'blocks',value:4}},{type:'question',id:'q1',kind:'choice',stem:'How many sides does a square have?',choices:['3','4'],answer:[1],explanation:'A square has four sides.'}];
assert.deepEqual(checkDoc(doc,true),[]);
const course=toCourse(doc,{id:'guide-test',version:1,review:'not_reviewed',author:'Synthetic'},()=> '');
for(const lesson of (course as any).lessons)assert.deepEqual(validateLessonSource(lesson.body),[]);
assert.deepEqual(checkDoc(migrateCommunityDocToCanonical(doc,'guide-test',()=>''),true),[]);
const html=renderToStaticMarkup(React.createElement(CommunityAuthorGuide));
assert(html.includes('Community authoring guide')&&html.includes('Authoring guide sections'));
assert(!html.includes('<script')&&!html.includes('contenteditable'));
assert(html.includes('type="button"'),'Help buttons must not submit enclosing editor forms');
assert(!html.includes('href="#'),'Help must not mutate route/history');
for(const file of ['CommunityEditor.tsx','CanonicalCommunityEditor.tsx'])assert(readFileSync(new URL('../src/pages/'+file,import.meta.url),'utf8').includes('<CommunityAuthorGuide />'));
console.log('Community author guide: shared documentation, valid examples, accessible inert help and search tests passed.');
