import assert from 'node:assert/strict';
import { validateImageAsset, validateStaticSvg } from '../src/lib/imageAssets.ts';
const svg=(body:string)=>`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 10 10">${body}</svg>`;
const data=(text:string)=>'data:image/svg+xml;base64,'+Buffer.from(text).toString('base64');
const valid=svg('<defs><linearGradient id="shade"><stop offset="0" stop-color="red"/></linearGradient></defs><style>text{paint-order:stroke;stroke:#fff;stroke-width:4px}</style><path d="M0 0 L10 10" fill="url(#shade)"/><text x="1" y="2">Safe &amp; exact</text>');
assert.deepEqual(validateStaticSvg(valid),[]);
const bytes=data(valid);assert.deepEqual(validateImageAsset(bytes),[]);assert.equal(bytes,data(valid));
for(const body of ['<script>alert(1)</script>','<foreignObject><div>HTML</div></foreignObject>','<path onload="alert(1)"/>','<use href="https://evil.test/a.svg#x"/>','<use href="javascript:alert(1)"/>','<image href="data:image/png;base64,YQ=="/>','<path fill="url(https://evil.test/x)"/>','<path fill="u&#114;l(https://evil.test/x)"/>','<style>@import "https://evil.test";</style>','<style>path{fill:u\\72l(https://evil.test/x)}</style>','<style>path{behavior:evil}</style>','<animate attributeName="href" values="javascript:evil"/>','<svg xmlns="http://evil.test"/>','<path style="fill: red; background:url(https://evil.test)"/>','<path xmlns:a="https://evil.test" a:onclick="evil"/>'])assert(validateStaticSvg(svg(body)).length,body);
for(const text of ['<!DOCTYPE svg [<!ENTITY x SYSTEM "file:///secret">]>'+svg('<text>&x;</text>'),'<?xml-stylesheet href="https://evil.test"?>'+svg(''),'<svg xmlns="http://www.w3.org/2000/svg"><path></svg>',svg('<g>'.repeat(70)+'</g>'.repeat(70))])assert(validateStaticSvg(text).length,text);
assert(validateImageAsset('data:image/svg+xml;base64,/w==').length,'invalid UTF8');
