import assert from "node:assert/strict";
import { classFile, verifyHandIn } from "../src/lib/classroom.ts";
import { preparePersistedHandIn } from "../src/lib/classroomExport.ts";
import { createSpreadsheetSubmission, appendSpreadsheetSubmission } from "../src/lib/spreadsheetEvidence.ts";
import { prepareSpreadsheetSubmission, beginSpreadsheetSubmissionSave, failSpreadsheetSubmissionSave, confirmSpreadsheetSubmissionSave } from "../src/lib/spreadsheetSubmissionState.ts";
import { createClassroomSubmissionStore, type ClassroomSubmissionIO } from "../src/lib/classroomSubmissionStore.ts";
import { newClass, newStudent, type Family } from "../src/lib/family.ts";
import { emptyProgress } from "../src/lib/storage.ts";
import { SAMPLE_ASSIGNMENT } from "../src/lib/spreadsheetAssignments.ts";
const learner=newStudent("Learner",7),other=newStudent("Other",7);
const cls=newClass("Class",[learner.id,other.id]);cls.assignments=[{courseId:"math",assigned:"2026-10-28"}];
const family={format:"erudior-family",version:1,mode:"classroom",students:[learner,other],classes:[cls],state:"",route:"",year:{start:"2026-01-01",end:"2026-12-31"},dailyMinutes:180,parent:{password:{salt:"",hash:"",iterations:1},recovery:{salt:"",hash:"",iterations:1}},reminders:[],done:[]} as Family;
const joined={cls:classFile(family,cls,()=>"Math"),studentId:learner.id};
const assignment=structuredClone(SAMPLE_ASSIGNMENT);const workbook=structuredClone(assignment.starter);workbook.sheets.Budget.B3="=B1-B2";
const first=createSpreadsheetSubmission({id:"first",submittedAt:1,courseId:"math",lessonId:"lesson",assignment,workbook});
const foreign=createSpreadsheetSubmission({...first,id:"foreign",courseId:"science"});
let persisted=emptyProgress();persisted.spreadsheetSubmissions=appendSpreadsheetSubmission(appendSpreadsheetSubmission({},first),foreign);
let active:string|null=learner.id;
const exportIO={activeStudent:()=>active,loadProgress:async()=>structuredClone(persisted),loadFile:async()=>null};
prepareSpreadsheetSubmission(learner.id,first);beginSpreadsheetSubmissionSave(learner.id,first);failSpreadsheetSubmissionSave(learner.id,first);
let handin=await preparePersistedHandIn(joined,exportIO);assert.deepEqual(handin.progress.spreadsheetSubmissions,{},"failed optimistic evidence withheld even if later disk write included it");
beginSpreadsheetSubmissionSave(learner.id,first);confirmSpreadsheetSubmissionSave(learner.id,first);
handin=await preparePersistedHandIn(joined,exportIO);assert.deepEqual(Object.keys(handin.progress.spreadsheetSubmissions!),["first"]);await verifyHandIn(handin,family);
active=other.id;await assert.rejects(preparePersistedHandIn(joined,exportIO),/another learner/);
active=learner.id;await assert.rejects(preparePersistedHandIn(joined,{...exportIO,loadProgress:async()=>{active=other.id;return persisted;}}),/changed/);active=learner.id;
// Existing guest roster mode is a claim, not verified identity; keep documented compatibility.
active=null;assert.equal((await preparePersistedHandIn(joined,exportIO)).studentId,learner.id);active=learner.id;
const state=new Map<string,string>([["family",JSON.stringify(family)]]);
const io:ClassroomSubmissionIO={readState:async k=>state.get(k)??null,writeState:async(k,v)=>{state.set(k,v);},updateState:async(k,fn)=>{const text=await fn(state.get(k)??null);state.set(k,text);return text;},readFamily:async()=>JSON.parse(state.get("family")!),writeFamily:async f=>{state.set("family",JSON.stringify(f));},readFile:async()=>null,writeFile:async()=>{},now:()=>new Date().toISOString()};
let teacher=createClassroomSubmissionStore(io);
const received=await teacher.import(handin,family);const exact=JSON.stringify(received.record.snapshot);
await teacher.review({submissionId:received.record.id,eventId:"review1",status:"reviewed",reviewedAt:"2026-10-28T14:00:00Z",note:"Reviewed original formula and rubric"},family);
const changed=structuredClone(assignment);changed.answers={...changed.answers,"Budget!B3":999};
const second=createSpreadsheetSubmission({id:"second",submittedAt:2,courseId:"math",lessonId:"lesson",assignment:changed,workbook});
persisted.spreadsheetSubmissions=appendSpreadsheetSubmission(persisted.spreadsheetSubmissions!,second);
const next=await preparePersistedHandIn(joined,exportIO);await teacher.import(next,family);await teacher.import(handin,family);
teacher=createClassroomSubmissionStore(io);const records=await teacher.load();assert.equal(records.length,2);const previous=records.find(r=>r.id===received.record.id)!;
assert.equal(JSON.stringify(previous.snapshot),exact);assert.equal(previous.reviewEvents.length,1);assert.equal(previous.status,"reviewed");assert(records.some(r=>r.id!==previous.id&&r.status==="pending"));
const teacherProgress=JSON.parse(state.get(`progress-${learner.id}`)!);assert.deepEqual(Object.keys(teacherProgress.spreadsheetSubmissions).sort(),["first","second"]);assert.equal(state.has(`progress-${other.id}`),false);assert.equal(state.has(`records-${learner.id}`),false,"student automatic results never create authoritative academic grades");
console.log("classroom spreadsheet lifecycle: persisted learner export, pending/isolation filters, signed transport, exact review, revision history, retry/reload and academic-grade separation passed");
