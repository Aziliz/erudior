import assert from 'node:assert/strict';
import {emptyAdvancedAssessmentPack,parseAdvancedAssessmentPack,parseAdvancedAssessmentAssignment,createAdvancedAssessmentSession,applyAdvancedAssessmentCommand,replayAdvancedAssessmentSession,makeAdvancedAssessmentSubmission,parseAdvancedAssessmentSubmission,parseAdvancedAssessmentLibrary,advancedAssessmentJSON} from '../src/lib/advancedAssessment.ts';
import {matchAdvancedAssessmentV1} from '../src/lib/advancedAssessmentScoringV1.ts';
export const fixture=emptyAdvancedAssessmentPack('synthetic');fixture.misconceptions=[{id:'operation',title:'Operation check',explanation:'An authored response match is a prompt for discussion, not a diagnosis.'}];const q=fixture.variants[0].questions[0];if(q.kind!=='math')throw Error('fixture');q.steps[0].expected={kind:'number',value:4,tolerance:.01};q.steps[0].misconceptions=[{misconceptionId:'operation',accepted:['3']}];q.steps[1].expected={kind:'text',accepted:['four']};fixture.variants.push({...structuredClone(fixture.variants[0]),id:'b',title:'Variant B'});parseAdvancedAssessmentPack(fixture);
const at='2026-10-29T00:00:00.000Z';const pack={...fixture,revision:1,approval:{actor:'Local teacher',at}};const a=parseAdvancedAssessmentAssignment({id:'case',revision:1,studentId:'alice',title:'Synthetic assessment',instructions:'Explain and disclose assistance.',pack,variantId:'a',createdAt:at});
let s=createAdvancedAssessmentSession(a);let n=0;const act=(command:any)=>s=applyAdvancedAssessmentCommand(a,s,command,'e'+(++n),at);
act({kind:'math',questionId:'reason',stepId:'first',answer:'3',reasoning:'Synthetic first attempt'});let sub=makeAdvancedAssessmentSubmission(a,s,'early',at);assert.equal(sub.feedback.steps[0].status,'not_matched');assert.deepEqual(sub.feedback.steps[0].misconceptionIds,['operation']);assert(!sub.feedback.complete);
act({kind:'math',questionId:'reason',stepId:'first',answer:'4',reasoning:'Corrected operation with explanation'});assert.equal(s.events.length,2);assert.equal(replayAdvancedAssessmentSession(a,s).responses.length,1);assert.equal(sub.feedback.steps[0].status,'not_matched');act({kind:'math',questionId:'reason',stepId:'second',answer:' FOUR ',reasoning:'Named result'});
const audio={mime:'audio/wav',seconds:1,data:Buffer.from('RIFF0000WAVEsynthetic-not-production-audio').toString('base64')};act({kind:'oral',questionId:'explain',transcript:'My explanation is recorded in this transcript.',audio});act({kind:'assistance',text:'No assistance reported.'});sub=makeAdvancedAssessmentSubmission(a,s,'complete',at);assert(sub.feedback.complete);assert.equal(sub.feedback.oral[0].status,'human_review');assert(sub.feedback.oral[0].audioPresent);assert.equal(sub.feedback.steps[0].status,'matched');assert.equal(sub.feedback.steps[1].status,'matched');assert.deepEqual(parseAdvancedAssessmentSubmission(sub),sub);
for(const v of ['4x','Infinity','0x4','1/2'])assert(!matchAdvancedAssessmentV1(v,{kind:'number',value:4,tolerance:0}));assert(matchAdvancedAssessmentV1('4e0',{kind:'number',value:4,tolerance:0}));assert(!matchAdvancedAssessmentV1('1e999',{kind:'number',value:4,tolerance:0}));
for(const modify of [(x:any)=>x.feedback.scoringVersion=2,(x:any)=>x.feedback.steps[0].status='not_matched',(x:any)=>x.session.events[0].command.stepId='missing',(x:any)=>x.session.events[0].command.reasoning='']){const bad=structuredClone(sub);modify(bad);assert.throws(()=>parseAdvancedAssessmentSubmission(bad));}
for(const bad of [{...audio,mime:'text/html'},{...audio,data:'PHNjcmlwdD4='},{...audio,seconds:31},{...audio,data:'x'.repeat(1500000)},{...audio,data:'AB=='}])assert.throws(()=>act({kind:'oral',questionId:'explain',transcript:'A transcript.',audio:bad}));
assert.throws(()=>parseAdvancedAssessmentAssignment({...a,variantId:'missing'}));assert.throws(()=>applyAdvancedAssessmentCommand(a,s,{kind:'math',questionId:'explain',stepId:'first',answer:'4',reasoning:'Wrong kind'},'bad',at));
const library={...parseAdvancedAssessmentLibrary(null),packs:[pack],assignments:[a],sessions:[s],submissions:[sub]};assert.deepEqual(parseAdvancedAssessmentLibrary(library).submissions[0],sub);assert.throws(()=>parseAdvancedAssessmentLibrary({...library,sessions:[]}));assert.throws(()=>parseAdvancedAssessmentLibrary({...library,sessions:[{...s,events:s.events.slice(1),revision:s.revision-1}]}));
const newer={...structuredClone(pack),revision:2};newer.rubric.title='Changed';assert.throws(()=>parseAdvancedAssessmentLibrary({...library,packs:[pack,newer]}),/rubric/);newer.rubric.revision=2;parseAdvancedAssessmentLibrary({...library,packs:[pack,newer]});
const invalid=structuredClone(fixture);invalid.variants[0].questions.push(invalid.variants[0].questions[0]);assert.throws(()=>parseAdvancedAssessmentPack(invalid),/duplicate/);assert.throws(()=>advancedAssessmentJSON(JSON.parse('{"__proto__":1}')));const cycle:any={};cycle.x=cycle;assert.throws(()=>advancedAssessmentJSON(cycle));assert.throws(()=>parseAdvancedAssessmentPack({...fixture,execute:'x'}));
console.log('Advanced assessment model: frozen feedback, steps/revisions, exact variants/rubrics, bounded audio and immutable replay passed');
