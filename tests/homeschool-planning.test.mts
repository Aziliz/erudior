import assert from 'node:assert/strict';
import {emptyHomeschoolPlanning,parseHomeschoolPlanning,savePlacement,savePlannedCourse,savePlanMaterial,savePlannedTrip,removePlanningEntry,restoreHomeschoolPlanning,fourYearPlan,planningEvidenceStatus,MAX_PLANNING_BYTES,type PlannedCourse} from '../src/lib/homeschoolPlanning.ts';
import {emptyRecords,parseRecords,restoredRecords,saveRecords,loadRecords,updateRecordsAtomic,addTime,type RecordsIO} from '../src/lib/records.ts';
import {stateTransactions} from '../src/lib/stateLock.ts';
import {emptyAcademicRecords,auditAcademicRecords} from '../src/lib/academicRecords.ts';
let p=emptyHomeschoolPlanning();
p=savePlacement(p,{id:'placement',subject:'Math',level:'Algebra, independently of nominal grade',rationale:'Parent reviewed sample work'});
p=savePlacement(p,{...p.placements[0],level:'Geometry'});assert.equal(p.placements.length,1);assert.equal(p.placements[0].level,'Geometry');
assert.throws(()=>savePlacement(p,{...p.placements[0],id:'duplicate',subject:' math '}),/Invalid/);
const c:PlannedCourse={id:'course',title:'Synthetic science',courseId:'community:test',subject:'Science',year:'2026–2027',grade:9,credits:1,status:'planned',notes:'Proposed only',evidenceIds:['doc']};
for(const grade of [0,9,10,11,12])p=savePlannedCourse(p,{...c,id:`course${grade}`,grade,status:grade===12?'completed':'planned'});
assert.deepEqual(fourYearPlan(p).map(y=>[y.grade,y.courses.length,y.projectedCredits]),[[9,1,1],[10,1,1],[11,1,1],[12,1,1]]);assert.equal(fourYearPlan(emptyHomeschoolPlanning()).length,4);
p=savePlanMaterial(p,{id:'material',title:'Notebook',coursePlanId:'course9',quantity:'2',ready:false,notes:''});p=savePlanMaterial(p,{...p.materials[0],ready:true});
p=savePlannedTrip(p,{id:'trip',title:'Museum',date:'2028-02-29',location:'Local museum',subject:'Science',notes:'Bring notebook',evidenceIds:['doc','removed'],status:'planned'});
assert.deepEqual(planningEvidenceStatus(p.trips[0].evidenceIds,[{id:'doc',name:'Observation'}]),[{id:'doc',name:'Observation',missing:false},{id:'removed',name:'Missing attachment',missing:true}]);
const removed=removePlanningEntry(p,'courses','course9');assert.equal(removed.materials[0].coursePlanId,'');assert.equal(removed.materials[0].ready,true);assert.equal(removed.trips.length,1);
assert.equal(removePlanningEntry(p,'trips','trip').trips.length,0);assert.equal(removePlanningEntry(p,'placements','placement').placements.length,0);assert.equal(removePlanningEntry(p,'materials','material').materials.length,0);
assert.deepEqual(parseHomeschoolPlanning(JSON.parse(JSON.stringify(p))),p);
for(const grade of [-1,13,1.5,NaN])assert.throws(()=>savePlannedCourse(p,{...c,grade}),/Invalid/);
for(const credits of [-1,101,NaN,Infinity])assert.throws(()=>savePlannedCourse(p,{...c,credits}),/Invalid/);
for(const date of ['2027-02-29','2026-13-01','2026-01-32','yesterday'])assert.throws(()=>savePlannedTrip(p,{...p.trips[0],date}),/Invalid/);
for(const invalid of [{...p,version:2},{...p,origin:'verified'},{...p,approval:true},{...p,placements:[p.placements[0],p.placements[0]]},{...p,courses:[{...c,earnedCredits:3}]},{...p,courses:[{...c,evidenceIds:['doc','doc']}]},{...p,materials:[{...p.materials[0],coursePlanId:'unknown'}]},{...p,trips:[{...p.trips[0],status:'approved'}]},{...p,courses:Array.from({length:1001},(_,i)=>({...c,id:`c${i}`}))},{...p,placements:[{...p.placements[0],rationale:'x'.repeat(MAX_PLANNING_BYTES)}]},JSON.parse('{"version":1,"origin":"local","placements":[],"courses":[],"materials":[],"trips":[],"__proto__":{}}')])assert.throws(()=>parseHomeschoolPlanning(invalid),/Invalid/);
const records={...emptyRecords(),planning:p,academic:emptyAcademicRecords(),time:{'2026-10-30':{math:60}}};assert.deepEqual(parseRecords(records).planning,p);
const restored=restoredRecords(records);assert.equal(restored.planning?.origin,'imported');assert.equal(restored.planning?.courses.at(-1)?.status,'completed');assert.equal(auditAcademicRecords(restored.academic!).totalCredits,0,'completed planning does not earn credit');assert.equal(restoreHomeschoolPlanning(p).origin,'imported');assert.equal(savePlannedCourse(restoreHomeschoolPlanning(p),c).origin,'imported');assert.equal(restored.time['2026-10-30'].math,60);
const map=new Map<string,string>();let exists=true,allowed=true;
const tx=stateTransactions({read:async k=>map.get(k)??null,write:async(k,v)=>{if(v===null)map.delete(k);else map.set(k,v);},compareAndSwap:async(k,old,next)=>{if((map.get(k)??null)!==old)return false;map.set(k,next);return true;}});
const io:RecordsIO={read:async k=>map.get(k)??null,update:tx.update,remove:async k=>{map.delete(k);},exists:async()=>exists};
await saveRecords('child',records,{guard:()=>{if(!allowed)throw Error('Locked');}},io);const snapshot=await loadRecords('child',io);
await updateRecordsAtomic('child',r=>addTime(r,'2026-10-30','math',30),{},io);assert.deepEqual((await loadRecords('child',io)).planning,p);await assert.rejects(()=>saveRecords('child',{...snapshot,planning:removed},{},io),/changed in another view/);assert.equal((await loadRecords('child',io)).time['2026-10-30'].math,90);
const before=map.get('records-child');allowed=false;await assert.rejects(()=>saveRecords('child',{...records,revision:2},{guard:()=>{if(!allowed)throw Error('Locked');}},io),/Locked/);assert.equal(map.get('records-child'),before);assert.equal(map.has('records-other'),false);exists=false;await assert.rejects(()=>saveRecords('child',records,{},io),/deleted/);
console.log('Homeschool planning model, bounds, evidence, restore provenance, shared CAS and timer isolation passed.');
