import assert from 'node:assert/strict';
import { cloneAudioClip, cloneCourseAudioFields, cloneQuestionAudioFields, cloneVocabAudioFields, embeddedAudioBytes, MAX_AUDIO_CLIP_BYTES, validateAudioClip, validateCourseAudioFields, validateEmbeddedAudio, validateQuestionAudioFields, validateVocabAudioFields } from '../src/lib/courseAudio.ts';
import { mediaProblems, parseMedia } from '../src/lib/dialogueContent.ts';
const clip = 'data:audio/mpeg;base64,AA==';
assert.equal(embeddedAudioBytes(clip),1);
for (const bad of ['data:audio/mpeg;base64,A', 'data:audio/mpeg;base64,AB==', 'data:audio/mpeg;base64,AAB=', 'data:audio/mpeg;base64,AAA', 'data:audio/mpeg;base64,AA===', 'data:audio/mpeg;base64,', 'data:text/html;base64,AA==', 'data:audio/svg+xml;base64,AA==', 'https://example.test/a.mp3', '//example.test/a.mp3', 'file:///a.mp3', '../a.mp3', '/a.mp3', 'audio/../a.mp3', 'audio/%2e%2e/a.mp3']) assert.ok(validateEmbeddedAudio(bad).length, bad);
const exact = {src:clip,text:'  Original\n transcript  ',lang:'de-DE'};
assert.deepEqual(cloneAudioClip(exact),exact);
assert.notEqual(cloneAudioClip(exact),exact);
assert.deepEqual(cloneAudioClip({text:' Words ',lang:'de'}),{text:' Words ',lang:'de'});
assert.ok(validateAudioClip({...exact,segments:[]}).length);
assert.ok(validateAudioClip(Object.create({text:'inherited'})).length);
assert.ok(validateAudioClip({text:'   '}).length);
assert.ok(validateAudioClip({...exact,lang:'bad language'}).length);
const lib = {readAloud:false,audio:{'Original WORD!':clip,'sound:m':'say:  Em  '}};
const cloned=cloneCourseAudioFields(lib);
assert.deepEqual(cloned,lib); assert.notEqual(cloned.audio,lib.audio);
assert.ok(validateCourseAudioFields({audio:{'Word!':clip,'ｗｏｒｄ':clip}}).some(v=>v.includes('colliding')));
assert.ok(validateCourseAudioFields({audio:JSON.parse('{"__proto__":"say:bad"}')} ).length);
assert.ok(validateCourseAudioFields({readAloud:'false'}).length);
assert.equal(validateQuestionAudioFields({audio:exact,listen:'Original WORD!',blend:['c[k]',' a ','t']}).length,0);
assert.equal(validateQuestionAudioFields({listen:clip}).length,0);
assert.ok(validateQuestionAudioFields({listen:'data:audio/mpeg;base64,A'}).length);
assert.ok(validateQuestionAudioFields({listen:'https://example.test/a.mp3'}).length);
assert.ok(validateQuestionAudioFields({blend:['ok',1]}).length);
assert.equal(validateVocabAudioFields({audio:clip}).length,0);
assert.ok(validateVocabAudioFields({audio:'https://example.test/a.mp3'}).length);
assert.deepEqual(cloneAudioClip({src:'audio/original.mp3',text:' exact '},{mode:'source'}),{src:'audio/original.mp3',text:' exact '});
assert.ok(validateAudioClip({src:'audio/original.mp3'}).some(v=>v.includes('unresolved local')));
for(const ref of ['https://example.test/a.mp3','../a.mp3']) assert.ok(validateEmbeddedAudio(ref,'audio',{mode:'source'}).length);
const atLimit='data:audio/wav;base64,'+Buffer.alloc(MAX_AUDIO_CLIP_BYTES).toString('base64');
assert.deepEqual(validateEmbeddedAudio(atLimit),[]);
assert.ok(validateEmbeddedAudio('data:audio/wav;base64,'+Buffer.alloc(MAX_AUDIO_CLIP_BYTES+1).toString('base64')).length);
const source='```dialogue lang=de-DE\n# Original\nSpeaker: Words\n= Translation\naudio: '+clip+'\n```';
assert.deepEqual(mediaProblems(source),[]);
assert.equal(parseMedia('dialogue',' lang=de-DE','Speaker: Words\naudio: '+clip).lines[0].audio,clip);
assert.ok(mediaProblems(source.replace(clip,'data:audio/mpeg;base64,A')).length);
assert.ok(mediaProblems('```speak\nWords').length);

const localSource=source.replace(clip,'audio/original.mp3');
assert.deepEqual(mediaProblems(localSource,{mode:'source'}),[]);
assert.ok(mediaProblems(localSource).some(v=>v.includes('unresolved local')));

const question = {audio:exact,listen:'  Original words  ',blend:['c[k]',' a ','t']};
assert.deepEqual(cloneQuestionAudioFields(question), question);
assert.notEqual(cloneQuestionAudioFields(question).blend,question.blend);
assert.notEqual(cloneQuestionAudioFields(question).audio,question.audio);
assert.deepEqual(cloneVocabAudioFields({audio:clip}),{audio:clip});
console.log('course audio contract: all tests passed');
