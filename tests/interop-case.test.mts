import assert from 'node:assert/strict';
import { createCaseReview, parseCaseReview, exportSkillsToCase, parseCasePackage, serializeCasePackage } from '../src/lib/interopCase.ts';
const skills=[{id:'math.base',title:'Base <skill>',prerequisites:[],evidence:{}},{id:'math.next',title:'Next',prerequisites:['math.base'],evidence:{}}];
const options={namespace:'https://example.org/framework',title:'Existing skills',creator:'Test operator',lastChangeDateTime:'2026-10-29T00:00:00Z'};
const p=await exportSkillsToCase(skills,options);
assert.deepEqual(parseCasePackage(serializeCasePackage(p)),p);
assert.deepEqual(await exportSkillsToCase(skills,options),p);
assert.equal(p.CFAssociations.find(a=>a.associationType==='precedes')?.originNodeURI.identifier,p.CFItems[0].identifier);
assert.equal(p.CFAssociations.find(a=>a.associationType==='precedes')?.destinationNodeURI.identifier,p.CFItems[1].identifier);
const altered=await exportSkillsToCase([{...skills[0],title:'Renamed'},skills[1]],{...options,lastChangeDateTime:'2026-10-30T00:00:00Z'});
assert.equal(altered.CFItems[0].identifier,p.CFItems[0].identifier);
assert.notEqual((await exportSkillsToCase(skills,{...options,namespace:'https://other.example/framework'})).CFItems[0].identifier,p.CFItems[0].identifier);
const copy=()=>JSON.parse(JSON.stringify(p));
const reject=(change:(p:any)=>void)=>{const x=copy();change(x);assert.throws(()=>parseCasePackage(x),/CASE/);};
reject(x=>x.CFDocument.caseVersion='1.0');reject(x=>x.CFDocument.unknown='lost');reject(x=>x.CFRubrics=[]);reject(x=>x.CFDefinitions={});
reject(x=>x.CFItems.push({...x.CFItems[0]}));reject(x=>x.CFItems[1].uri=x.CFItems[0].uri);reject(x=>x.CFItems[0].identifier='vendor-id');
reject(x=>x.CFAssociations[0].associationType='isPrerequisiteOf');reject(x=>x.CFAssociations[0].originNodeURI.uri='https://different.example/');
reject(x=>x.CFAssociations[0].destinationNodeURI.targetType='other');reject(x=>x.CFDocument.uri='javascript:alert(1)');reject(x=>x.CFDocument.uri='https://user:pass@example.org/');
reject(x=>x.CFDocument.lastChangeDateTime='2026-02-31T00:00:00Z');reject(x=>x.CFItems[0].fullStatement='');reject(x=>x.CFItems[0].fullStatement='x'.repeat(50001));
assert.throws(()=>parseCasePackage('{"__proto__":{},"CFItems":[]}'),/reserved/);assert.throws(()=>parseCasePackage('not JSON'),/invalid JSON/);
const metadata=copy();metadata.CFDocument.description='**Preserve**';metadata.CFDocument.extensions={vendor:{value:['safe',1]}};metadata.CFItems[0].educationLevel=['05'];metadata.CFItems[0].subject=['Math'];
assert.deepEqual(parseCasePackage(serializeCasePackage(metadata)),metadata);
const before=JSON.stringify(skills);const review=createCaseReview(p,[{caseItemId:p.CFItems[0].identifier,localSkillId:skills[0].id}],skills);assert.equal(JSON.stringify(skills),before);assert.equal(review.mappings.length,1);assert.equal(review.package.CFItems[0].fullStatement,'Base <skill>');
review.package.CFItems[0].fullStatement='Mutated';assert.equal(p.CFItems[0].fullStatement,'Base <skill>');
assert.throws(()=>createCaseReview(p,[{caseItemId:p.CFItems[0].identifier,localSkillId:'missing'}],skills),/mapping/);
assert.throws(()=>createCaseReview(p,[{caseItemId:p.CFItems[0].identifier,localSkillId:skills[0].id},{caseItemId:p.CFItems[0].identifier,localSkillId:skills[1].id}],skills),/mapping/);
await assert.rejects(()=>exportSkillsToCase([skills[1]],options),/Missing prerequisite/);
await assert.rejects(()=>exportSkillsToCase(skills,{...options,namespace:'https://example.org/?token=secret'}),/namespace/);
const external=copy();external.CFAssociations[0].destinationNodeURI={title:'External',identifier:'11111111-1111-4111-8111-111111111111',uri:'https://external.example/item'};
assert.ok(createCaseReview(external,[],skills).warnings.some(w=>w.includes('not fetched')));
assert.ok(createCaseReview(metadata,[],skills).warnings.some(w=>w.includes('opaque')));
console.log('PASS CASE package round-trip, stable identities, explicit mapping and fail-closed profile');

const reopened=parseCaseReview(JSON.stringify({...createCaseReview(p,[],skills),warnings:['Trusted']}),skills);assert.ok(!reopened.warnings.includes('Trusted'));
assert.throws(()=>parseCaseReview({...reopened,version:2},skills),/unsupported/);
assert.throws(()=>parseCaseReview({...reopened,admin:true},skills),/unsupported/);
