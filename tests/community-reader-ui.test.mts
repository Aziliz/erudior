import assert from "node:assert/strict";
import { readFileSync } from "node:fs";
import { JSDOM } from "jsdom";
const texts = JSON.parse(readFileSync(new URL("./fixtures/community-reader.json", import.meta.url), "utf8"));
const dom = new JSDOM('<!doctype html><div id="root"></div>', { url: "https://example.test" });
Object.assign(globalThis, { window: dom.window, document: dom.window.document, HTMLElement: dom.window.HTMLElement, localStorage: dom.window.localStorage, IS_REACT_ACT_ENVIRONMENT: true });
Object.defineProperty(globalThis, "navigator", { configurable: true, value: dom.window.navigator });
const React = await import("react");
const { createRoot } = await import("react-dom/client");
const { default: Editor } = await import("../src/pages/CommunityEditor.tsx");
const { ReviewItem } = await import("../src/pages/ReviewQueue.tsx");
const { api: community } = await import("../src/lib/community.ts");
const { checkDoc } = await import("../src/lib/communityFormat.ts");
const old = { ...community };
const question = { stem: "What was observed?", choices: ["A bird", "A fish"], answer: [0], explanation: "A bird." };
const block = { type: "text", md: "Keep **rich lesson** formatting." };
let stored: any = { format: "erudior-community", version: 1, title: "Read observations", description: "Read and reflect.", subject: "Reading and literature", level: "Middle School", modules: [{ id: "m1", title: "Reading", quiz: [{ ...question, id: "mq1" }] }], lessons: [{ id: "l1", module: "m1", title: "Observe", blocks: [block, { ...question, type: "question", id: "q1" }] }], decks: [], texts, futureMetadata: { keep: true } };
let publication: any, failSave = false;
const reviews: any[][] = [], notices: string[] = [];
community.draft = async () => ({ id: "course", status: "draft", version: 0, review: "not_reviewed", reviewNote: null, role: "owner", doc: structuredClone(stored) });
community.save = async (_id, doc) => { if (failSave) throw Error("Offline save"); stored = structuredClone(doc); return {}; };
community.editors = async () => ({ owner: null, editors: [] });
community.publish = async () => { assert.deepEqual(checkDoc(stored, true), []); publication = structuredClone(stored); return { version: 1 }; };
community.course = async () => ({ id: "course", version: 1, author: "Author", review: "not_reviewed", doc: structuredClone(publication) }) as never;
community.review = async (...args) => { reviews.push(args); return {} as never; };
const api: any = { toast: (message: string) => notices.push(message), go() {} };
const root = createRoot(document.getElementById("root")!);
const button = (label: string, last = false) => { const buttons = [...document.querySelectorAll("button")].filter(b => b.textContent?.trim() === label); assert(buttons.length, label); return buttons[last ? buttons.length - 1 : 0]; };
const prefix = (label: string) => [...document.querySelectorAll("button")].find(b => b.textContent?.startsWith(label))!;
const click = (el: HTMLElement) => React.act(async () => el.click());
const field = (label: string) => [...document.querySelectorAll("label")].find(l => l.firstChild?.textContent?.trim() === label)!.querySelector("input,textarea") as HTMLInputElement;
async function fill(label: string, value: string) { const input = field(label); await React.act(async () => { Object.getOwnPropertyDescriptor(input.tagName === "TEXTAREA" ? dom.window.HTMLTextAreaElement.prototype : dom.window.HTMLInputElement.prototype, "value")!.set!.call(input, value); input.dispatchEvent(new dom.window.Event("input", { bubbles: true })); }); }
const mount = () => React.act(async () => root.render(React.createElement(Editor, { api, id: "course" })));
try {
  await mount(); await click(button("Reading library (1)")); await click(button("Edit text: An observation poem"));
  await fill("Text title", "Observation poem revised"); await click(button("Edit section: Opening lines"));
  const body = texts[0].sections[0].body + "\nOne more fictional line."; await fill("Section body", body);
  await click(button("Unlink question l1-q1")); await click(prefix("Link question l1-q1:"));
  assert(document.body.textContent!.includes("Unlink question l1-q1"));
  failSave = true; await click(button("Save draft")); assert(document.body.textContent!.includes("Not saved:"));
  failSave = false; await click(button("Save draft"));
  assert.deepEqual(stored.lessons[0].blocks[0], block); assert.deepEqual(stored.futureMetadata, { keep: true });
  assert.equal(stored.texts[0].sections[0].body, body); assert.equal(stored.texts[0].source, texts[0].source);
  await click(button("Lessons (1)")); await click(prefix("Delete: Question")); assert(notices.some(n => /Unlink reading questions/.test(n)));
  assert(document.querySelector(".block-question"), "referenced question remains in draft");
  await React.act(async () => root.render(null)); await mount(); await click(button("Reading library (1)"));
  await click(button("Edit text: Observation poem revised")); await click(button("Edit section: Opening lines")); assert.equal(field("Section body").value, body);
  await click(button("Publish")); await click(button("Publish", true)); assert.deepEqual(publication.texts, stored.texts);
  const entry: any = { id: "course", title: stored.title, description: stored.description, subject: stored.subject, level: stored.level, version: 1, author: "Author", review: "not_reviewed", counts: { lessons: 1, questions: 2, cards: 0 }, updated: null };
  await React.act(async () => root.render(React.createElement(ReviewItem, { api, c: entry, onDone() {} })));
  await click(prefix("Read the course"));
  const inspection = document.querySelector('[aria-label="Reading library inspection"]')!;
  for (const value of ["Observation poem revised", "Test fixture author", "2026", "poem", "en-US", "Line numbering: 2", texts[0].source, "observing", "[^1]: A fictional observation.", "One more fictional line.", "l1-q1: What was observed?", "m1-mq1: What was observed?"])
    assert(inspection.textContent!.includes(value), value);
  assert(prefix("Mark version").disabled);
  await click(document.querySelector('input[type="checkbox"]') as HTMLInputElement); assert(!prefix("Mark version").disabled);
  await click(prefix("Reload course contents")); assert(prefix("Mark version").disabled);
  await click(document.querySelector('input[type="checkbox"]') as HTMLInputElement); await click(prefix("Mark version")); assert.deepEqual(reviews, [["course", "reviewed", "", 1]]);
  await React.act(async () => root.render(React.createElement(ReviewItem, { api, c: { ...entry, version: 2 }, onDone() {} })));
  await click(prefix("Read the course")); assert(prefix("Mark version").disabled); assert(notices.some(n => /version changed/.test(n)));
  console.log("community reader UI: full-body author/save/reopen/publish, first-bank links and removal guard, exact-version full-text review acknowledgment passed");
} finally { Object.assign(community, old); await React.act(async () => root.unmount()); dom.window.close(); }
