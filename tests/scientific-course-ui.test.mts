import assert from 'node:assert/strict';
import {JSDOM} from 'jsdom';
import {emptyCourse} from '../src/lib/course.ts';
const dom=new JSDOM('<!doctype html><body><div id="root"></div></body>',{url:'https://example.test'});
Object.assign(globalThis,{window:dom.window,document:dom.window.document,HTMLElement:dom.window.HTMLElement,localStorage:dom.window.localStorage,IS_REACT_ACT_ENVIRONMENT:true});Object.defineProperty(globalThis,'navigator',{value:dom.window.navigator,configurable:true});
const {createElement,act}=await import('react');const {createRoot}=await import('react-dom/client');const {default:Editor}=await import('../src/components/CourseScientificEditor.tsx');
const root=createRoot(document.getElementById('root')!);let course=emptyCourse('Test'),pending=false;course.lessons=[{id:'intro',title:'Test',module:course.modules[0].id,body:''}];
const render=()=>root.render(createElement(Editor,{course,update:fn=>{course=fn(course);render();},onEditingChange:v=>{pending=v;}}));await act(async()=>render());
const click=async(t:string)=>{const b=[...document.querySelectorAll('button')].find(b=>b.textContent?.trim()===t);assert(b,t);await act(async()=>b.click());};
const fill=async(label:string,v:string)=>{const el=document.querySelector(`[aria-label="${label}"]`) as HTMLInputElement;assert(el,label);const proto=el.tagName==='SELECT'?dom.window.HTMLSelectElement.prototype:el.tagName==='TEXTAREA'?dom.window.HTMLTextAreaElement.prototype:dom.window.HTMLInputElement.prototype;await act(async()=>{Object.getOwnPropertyDescriptor(proto,'value')!.set!.call(el,v);el.dispatchEvent(new dom.window.Event(el.tagName==='SELECT'?'change':'input',{bubbles:true}));});};
await click('Add scientific workspace');assert(pending);await fill('Workspace title','Synthetic project');await fill('Scientific attached lesson','intro');await click('Apply workspace to course');assert(!pending);assert.equal(course.scientificWorkspaces?.[0].title,'Synthetic project');assert.equal(course.scientificWorkspaces?.[0].revision,1);assert.equal(course.scientificWorkspaces?.[0].lessonId,'intro');
await click('Edit workspace Synthetic project');await fill('Workspace title','Unsaved edit');await click('Discard workspace draft');assert.equal(course.scientificWorkspaces?.[0].title,'Synthetic project');assert(!pending);
await click('Edit workspace Synthetic project');await fill('Channel 1 ID','invalid id');await click('Apply workspace to course');assert(document.querySelector('[role="alert"]'));assert(pending,'invalid definition stays editable');assert.equal(course.scientificWorkspaces?.[0].steps.length,1);
await click('Discard workspace draft');await click('Edit workspace Synthetic project');await fill('Step 1 instructions','Changed reviewed source');await click('Apply workspace to course');assert.equal(course.scientificWorkspaces?.[0].revision,2);assert.equal(course.scientificWorkspaces?.[0].steps[0].instructions,'Changed reviewed source');
await click('Edit workspace Synthetic project');await fill('Scientific instrument','gas');assert((document.querySelector('[aria-label="Model assumptions and limitations"]') as HTMLTextAreaElement).value.includes('Ideal gas'));await click('Add design criterion');await fill('Design brief','Compare two virtual instrument configurations');await fill('Safety and supervision','Educational simulation only');await fill('Model assumptions and limitations','Ideal gas; no physical apparatus');await click('Apply workspace to course');assert.equal(course.scientificWorkspaces?.[0].instrument.kind,'gas');assert.equal(course.scientificWorkspaces?.[0].design.brief,'Compare two virtual instrument configurations');const saved=structuredClone(course.scientificWorkspaces![0]);await click('Edit workspace Synthetic project');await click('Discard workspace draft');assert.deepEqual(course.scientificWorkspaces![0],saved);
await click('Remove workspace Synthetic project');await click('Keep workspace');assert.equal(course.scientificWorkspaces?.length,1);await click('Remove workspace Synthetic project');await click('Confirm workspace removal');assert.equal(course.scientificWorkspaces?.length,0);
await act(async()=>root.unmount());console.log('Scientific course UI: controlled structured author, apply/reopen, invalid definition preservation, discard, revision and removal confirmation passed');
