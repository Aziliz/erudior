import assert from 'node:assert/strict';
import fs from 'node:fs';
import { emptyCourse, normalizeCourse, serializeCourse } from '../src/lib/course.ts';
import { hasParentCourseReview, makeParentCourseReview, parentCourseDigest, saveParentCourseAssignment, withoutParentCourseReviews, type ParentAssignmentIO } from '../src/lib/parentCourseReview.ts';
import type { Family } from '../src/lib/family.ts';
import { stateTransactions } from '../src/lib/stateLock.ts';
const course={...emptyCourse('Synthetic review fixture'),community:{id:'fixture',version:1,author:'Synthetic',review:'not_reviewed' as const}};
const digest=await parentCourseDigest(course),receipt=makeParentCourseReview('child',course,digest,'2026-10-30T00:00:00.000Z');
assert.equal(digest.length,64);
assert.equal(await parentCourseDigest(normalizeCourse(JSON.parse(serializeCourse(course)))),digest);
assert.equal(await parentCourseDigest(Object.fromEntries(Object.entries(course).reverse()) as typeof course),digest);
assert(hasParentCourseReview('child',course,digest,receipt));
assert(!hasParentCourseReview('sibling',course,digest,receipt));
assert(!hasParentCourseReview('child',course,undefined,receipt));
assert(!hasParentCourseReview('child',{...course,community:{...course.community,version:2}},digest,receipt));
assert(!hasParentCourseReview('child',course,await parentCourseDigest({...course,title:'Changed bytes'}),receipt));
assert(!hasParentCourseReview('child',course,digest,{...receipt,reviewedAt:'invalid'}));
assert.notEqual(await parentCourseDigest({...course,audio:{sample:'data:audio/wav;base64,UklGRg=='}}),digest);
assert.notEqual(await parentCourseDigest({...course,community:{...course.community,author:'Changed'}}),digest);
assert.throws(()=>makeParentCourseReview('child',course,'fake'),/incomplete/);
const secret={salt:'synthetic',hash:'synthetic',iterations:1000};
const family:Family={format:'erudior-family',version:1,state:'',route:'',year:{start:'2026-01-01',end:'2026-12-31'},dailyMinutes:60,parent:{password:secret,recovery:secret},students:[{id:'child',name:'Fixture',grade:1,assigned:[],freeChoice:true},{id:'sibling',name:'Other',grade:4,assigned:[],freeChoice:true}],reminders:[],done:[]};
const assignment={courseId:course.id,subject:'Science',communityReview:receipt};
function fixture(){let stored=JSON.stringify(family),exists=true,after=()=>{};const io:ParentAssignmentIO={exists:async()=>exists,update:async fn=>{const next=await fn(stored);stored=next;after();return next;}};return{io,get:()=>JSON.parse(stored) as Family,set:(f:Family)=>{stored=JSON.stringify(f);},remove:()=>{exists=false;},after:(fn:()=>void)=>{after=fn;}};}
const f=fixture();let guards=0;
const assigned=await saveParentCourseAssignment(family,'child',course.id,assignment,()=>{guards++;},f.io);
assert(guards>=5);assert.equal(assigned.students[0].assigned.length,1);assert.equal(assigned.students[1].assigned.length,0);
await assert.rejects(saveParentCourseAssignment(family,'child',course.id,assignment,()=>{},f.io),/changed/);
const replaced=await saveParentCourseAssignment(assigned,'child',course.id,{...assignment,subject:'Other'},()=>{},f.io);
assert.equal(replaced.students[0].assigned.length,1);assert.equal(replaced.students[0].assigned[0].subject,'Other');
const revoked=await saveParentCourseAssignment(replaced,'child',course.id,null,()=>{},f.io);assert.equal(revoked.students[0].assigned.length,0);
await assert.rejects(saveParentCourseAssignment(revoked,'sibling',course.id,assignment,()=>{},f.io),/does not belong/);
await assert.rejects(saveParentCourseAssignment(revoked,'child',course.id,assignment,()=>{throw Error('Locked');},f.io),/Locked/);
assert.equal(f.get().students[0].assigned.length,0);
const interrupted=fixture();let calls=0;await assert.rejects(saveParentCourseAssignment(family,'child',course.id,assignment,()=>{if(++calls===4)throw Error('Credentials changed');},interrupted.io),/Credentials changed/);assert.equal(interrupted.get().students[0].assigned.length,0);
const concurrent=fixture();concurrent.set({...family,students:family.students.map(s=>s.id==='child'?{...s,name:'New name'}:s)});await assert.rejects(saveParentCourseAssignment(family,'child',course.id,assignment,()=>{},concurrent.io),/changed/);assert.equal(concurrent.get().students[0].name,'New name');
const dead=fixture();dead.remove();await assert.rejects(saveParentCourseAssignment(family,'child',course.id,assignment,()=>{},dead.io),/deleted/);
const race=fixture();race.after(race.remove);await assert.rejects(saveParentCourseAssignment(family,'child',course.id,assignment,()=>{},race.io),/deleted/);assert(!race.get().students.some(s=>s.id==='child'));assert.equal(race.get().students[0].id,'sibling');
const restored=withoutParentCourseReviews(assigned);assert.equal(restored.students[0].assigned[0].communityReview,undefined);assert.equal(restored.students[0].assigned[0].courseId,course.id);assert(assigned.students[0].assigned[0].communityReview);
assert.match(fs.readFileSync('src/lib/backup.ts','utf8'),/saveFamily\(withoutParentCourseReviews\(b.family\)\)/);
let transactionRaw:string|null=JSON.stringify(family);
const backend={read:async()=>transactionRaw,write:async(_name:string,value:string|null)=>{transactionRaw=value;},compareAndSwap:async(_name:string,expected:string|null,value:string)=>{if(transactionRaw!==expected)return false;transactionRaw=value;return true;}};
const transactions=stateTransactions(backend);
const lockedIO:ParentAssignmentIO={update:fn=>transactions.update('family',fn),exists:async()=>JSON.parse((await backend.read())!).students.some((s:{id:string})=>s.id==='child')};
await saveParentCourseAssignment(family,'child',course.id,assignment,async()=>{assert(JSON.parse((await backend.read())!).parent.password);},lockedIO);
assert.equal(JSON.parse(transactionRaw!).students[0].assigned.length,1);
console.log('Parent review content/version/profile, pending digest, CAS, revocation, deletion, backup and nested authorization-read tests passed.');
