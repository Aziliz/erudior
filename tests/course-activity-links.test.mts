import assert from 'node:assert/strict';
import {JSDOM} from 'jsdom';
import {emptyCourse} from '../src/lib/course.ts';
import {emptyAdvancedAssessmentPack} from '../src/lib/advancedAssessment.ts';
import {emptyScientificPack} from '../src/lib/scientificWorkspace.ts';
import {emptyBranchingPack} from '../src/lib/branchingEngine.ts';
import {SAMPLE_ASSIGNMENT} from '../src/lib/spreadsheetAssignments.ts';
import {courseActivities} from '../src/lib/courseActivities.ts';
const dom=new JSDOM('<!doctype html><body><div id="root"></div></body>',{url:'https://example.test'});
Object.assign(globalThis,{window:dom.window,document:dom.window.document,HTMLElement:dom.window.HTMLElement,localStorage:dom.window.localStorage,IS_REACT_ACT_ENVIRONMENT:true});Object.defineProperty(globalThis,'navigator',{value:dom.window.navigator,configurable:true});
const {createElement,act}=await import('react');const {createRoot}=await import('react-dom/client');const {default:Links}=await import('../src/components/CourseActivityLinks.tsx');const {default:View}=await import('../src/pages/CourseActivityView.tsx');
const course=emptyCourse('Synthetic integration');course.revision=7;course.lessons=[{id:'intro',title:'Introduction',module:course.modules[0].id,body:'Untouched reviewed prose'},{id:'other',title:'Other lesson',module:course.modules[0].id,body:''}];
course.advancedAssessments=[{...emptyAdvancedAssessmentPack('same'),title:'Reasoning',revision:2,lessonId:'intro'}];course.scientificWorkspaces=[{...emptyScientificPack('same'),title:'Experiment',revision:3,lessonId:'other'}];course.branchingScenarios=[{...emptyBranchingPack('same'),title:'Scenario',revision:4}];course.spreadsheetAssignments=[{...structuredClone(SAMPLE_ASSIGNMENT),id:'same',title:'Spreadsheet',lessonId:'intro'}];
assert.deepEqual(courseActivities(course,'intro').map(x=>x.kind),['advanced','spreadsheet']);assert.equal(courseActivities(course).length,4);assert.equal(courseActivities(course,'missing').length,0);
const root=createRoot(document.getElementById('root')!);const routes:any[]=[];const api:any={go:(v:any)=>routes.push(v),progress:{lessonsDone:{},attempts:[]},family:null};
const render=async(component:any,props:any)=>act(async()=>root.render(createElement(component,props)));
await render(Links,{api,course,lessonId:'intro'});assert.match(document.body.textContent!,/Apply this lesson/);assert(!document.body.textContent!.includes('Experiment'));let button=[...document.querySelectorAll('button')].find(x=>x.textContent==='Open Reasoning')!;await act(async()=>button.click());assert.deepEqual(routes.pop(),{name:'courseActivity',courseId:course.id,kind:'advanced',sourceId:'same'});
await render(Links,{api,course});assert.equal(document.querySelectorAll('li').length,4);await render(Links,{api,course,lessonId:'missing'});assert.equal(document.body.textContent,'');
await render(View,{api,course,kind:'advanced',sourceId:'same'});assert.match(document.body.textContent!,/review and assign|review its exact content/);assert.match(document.body.textContent!,/unavailable for this profile/);assert(!document.body.textContent!.includes('Experiment'));button=[...document.querySelectorAll('button')].find(x=>x.textContent?.includes('Return to lesson'))!;await act(async()=>button.click());assert.deepEqual(routes.pop(),{name:'lesson',courseId:course.id,lessonId:'intro'});
await render(View,{api,course,kind:'scientific',sourceId:'missing'});assert.match(document.querySelector('[role="alert"]')!.textContent!,/no longer/);assert(!document.body.textContent!.includes('My advanced assessments'));
const {default:CourseHome}=await import('../src/pages/CourseHome.tsx');
const engineOnly={...course,spreadsheetAssignments:[],scientificWorkspaces:[],branchingScenarios:[]};
await render(CourseHome,{api,course:engineOnly,tab:'work'});assert([...document.querySelectorAll('nav button')].some(b=>b.textContent==='Assignments'),'new-engine-only course exposes Assignments tab');assert(document.querySelector('[aria-label="Course engine activities"]'),'new-engine-only work tab renders launch links');
assert.equal(course.lessons[0].body,'Untouched reviewed prose');assert.equal(routes.length,0);await act(async()=>root.unmount());console.log('Course activity discovery and handoff UI passed');
