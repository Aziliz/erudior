import assert from 'node:assert/strict';
import {readFileSync} from 'node:fs';
import {validateCanonicalAuthoring} from '../src/lib/canonicalAuthoring.ts';
import {checkDoc,imageIds,toCourse} from '../src/lib/communityFormat.ts';
const fixture=JSON.parse(readFileSync(new URL('./fixtures/community-canonical.json',import.meta.url),'utf8'));
const origin='https://community.example',owned=`${origin}/images/question`,png='data:image/png;base64,AA==';
const inert=structuredClone(fixture),literal='![literal](https://outside.test/x.png)';
const plain=inert.course.banks[0].questions[0];
plain.stem=literal;plain.explanation=literal;plain.choices[0]=literal;
assert.deepEqual(validateCanonicalAuthoring(inert),[],'MathText prose is not Markdown');
const {transformCanonicalAssets}=await import('../src/lib/canonicalAssets.ts');
assert.deepEqual(transformCanonicalAssets(inert.course,()=>png),inert.course,'inert question prose is not rewritten');
const code=structuredClone(fixture),q=code.course.banks[0].questions[0];
q.type='code';q.choices=[];q.answer=[];q.code={language:'javascript',starter:'console.log("![literal](https://outside.test/x.png)")',tests:[{stdout:'hello'}]};
assert.deepEqual(validateCanonicalAuthoring(code),[],'code starter remains literal');
q.stem='![question](https://outside.test/x.png)';
assert(validateCanonicalAuthoring(code).some(e=>e.includes('image')),'code question stem is rendered Markdown');
q.stem='Safe stem';q.code.hints=['![hint](https://outside.test/x.png)'];
assert(validateCanonicalAuthoring(code).some(e=>e.includes('image')),'rendered code hints validated');
q.code.hints=[`![hint](${owned})`];
assert.deepEqual(validateCanonicalAuthoring(code,{communityImageOrigin:origin}),[]);
assert(transformCanonicalAssets(code.course,()=>png).banks[0].questions[0].code.hints[0].includes(png));
q.code.hints=[];q.stem=`![escaped \\] image](${owned})`;
const doc:any={format:'erudior-community',version:1,title:code.course.title,description:'Listing',subject:'Science',level:'Middle School',type:'Course',lessons:[],decks:[],canonical:code};
assert.deepEqual(checkDoc(doc,true,{communityImageOrigin:origin}),[]);assert.deepEqual(imageIds(doc,origin),['question']);
const before=structuredClone(doc),installed:any=toCourse(doc,{id:'test',version:1,author:'Publisher',review:'not_reviewed'},()=>png,origin);
assert(installed.banks[0].questions[0].stem.includes(png));assert.deepEqual(doc,before);
inert.course.glossary[0].definition=literal;inert.course.texts[0].glossary[0].definition=literal;
assert.deepEqual(validateCanonicalAuthoring(inert),[],'glossary MathText preserves literal Markdown');
assert.deepEqual(transformCanonicalAssets(inert.course,()=>png),inert.course,'glossary literals are never fetched or rewritten');
for(const kind of ['prose','poem','play']) {
 const p=structuredClone(fixture),text=p.course.texts[0];text.kind=kind;
 text.sections[0].body=`Body[^1]\n\n[^1]: ![note](${owned})`;
 assert.deepEqual(validateCanonicalAuthoring(p,{communityImageOrigin:origin}),[],kind);
 assert(transformCanonicalAssets(p.course,()=>png).texts[0].sections[0].body.includes(png));
 text.sections[0].body=text.sections[0].body.replace(owned,'https://outside.test/x.png');
 assert(validateCanonicalAuthoring(p).some(e=>e.includes('image')),kind+' note external image rejected');
}
console.log('canonical media: rendered code prompts/hints and reader footnotes owned/embedded; MathText, glossary and code literals untouched');
