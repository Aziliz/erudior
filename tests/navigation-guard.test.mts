import assert from "node:assert/strict";
import { JSDOM } from "jsdom";
import { requestNavigation, registerNavigationGuard, navigationPosition, withNavigationPosition, sameNavigationPosition, restoreBlockedPop } from "../src/lib/navigationGuard.ts";
assert.equal(requestNavigation(), true);
const seen: string[] = [];
const unregister = registerNavigationGuard(kind => { seen.push(kind); return false; });
assert.equal(requestNavigation("app"), false);
assert.equal(requestNavigation("history"), false);
assert.deepEqual(seen, ["app", "history"]);
unregister(); assert.equal(requestNavigation(), true);
const broken = registerNavigationGuard(() => { throw Error("test"); });
assert.equal(requestNavigation(), false); broken();
const state = (index: number, session = "test") => withNavigationPosition({ erudiorView: { name: "communityEdit", id: "draft" } }, { session, index });
assert.equal(navigationPosition(null), null);
assert.equal(navigationPosition({ erudiorNavigationPosition: { session: "test", index: NaN } }), null);
assert.equal(sameNavigationPosition(state(2), state(2)), true);
assert.equal(sameNavigationPosition(state(2), state(2, "other")), false);
const movements: number[] = [], pushes: Array<{ state: unknown; url: string | URL | null | undefined }> = [];
const history = { go: (delta?: number) => { movements.push(delta ?? 0); }, pushState: (data: unknown, _unused: string, url?: string | URL | null) => { pushes.push({ state: data, url }); } };
const current = { url: "/create/draft?tab=sheet#cell", state: state(2) };
assert.equal(restoreBlockedPop(history, current, state(1)).traversing, true);
assert.equal(restoreBlockedPop(history, current, state(3)).traversing, true);
assert.deepEqual(movements, [1, -1], "Back and Forward restore using actual relative indices");
assert.equal(pushes.length, 0);
const fallback = restoreBlockedPop(history, current, null);
assert.equal(fallback.traversing, false);
assert.equal(pushes[0].url, current.url);
assert.deepEqual((pushes[0].state as Record<string, unknown>).erudiorView, { name: "communityEdit", id: "draft" });
assert.notEqual(navigationPosition(pushes[0].state)!.session, "test", "unknown history starts a fresh lineage rather than guessing distance");
assert.equal(navigationPosition(pushes[0].state)!.index, 0);
assert.equal(movements.length, 2);
// Exercise actual Back/Forward URL and state restoration, not just offset math.
const dom = new JSDOM("<!doctype html>", { url: "https://example.test/a" });
const h = dom.window.history;
h.replaceState(state(0), "", "/a"); h.pushState(state(1), "", "/b"); h.pushState(state(2), "", "/c");
const move = (action: () => void) => new Promise<PopStateEvent>((resolve, reject) => {
  const timeout = setTimeout(() => reject(Error("history navigation timed out")), 2000);
  dom.window.addEventListener("popstate", event => { clearTimeout(timeout); resolve(event as unknown as PopStateEvent); }, { once: true });
  action();
});
const back = await move(() => h.back());
assert.equal(dom.window.location.pathname, "/b");
await move(() => { restoreBlockedPop(h, { url: "/c", state: state(2) }, back.state); });
assert.equal(dom.window.location.pathname, "/c");
assert.equal(sameNavigationPosition(h.state, state(2)), true);
await move(() => h.back());
const forward = await move(() => h.forward());
assert.equal(dom.window.location.pathname, "/c");
await move(() => { restoreBlockedPop(h, { url: "/b", state: state(1) }, forward.state); });
assert.equal(dom.window.location.pathname, "/b");
assert.equal(sameNavigationPosition(h.state, state(1)), true);
dom.window.close();
console.log("navigation guard: veto/release, fail-closed hooks, Back/Forward restoration and legacy history fallback passed");
