import assert from "node:assert/strict";
import { newKeyPair, signBytes, b64 } from "../src/lib/courseSign.ts";
import { GERMAN_RECOVERY, digest, recoveryDecision } from "../scripts/lib/courseArtifactRecovery.ts";
const keys = newKeyPair();
const source = Buffer.from("signed source"), old = Buffer.from("known previous");
const incident = { ...GERMAN_RECOVERY[0], expected: digest(source), previous: digest(old) } as unknown as typeof GERMAN_RECOVERY[number];
const catalog = Buffer.from(JSON.stringify({ format: "examiner-catalog", version: 1, courses: [{ id: incident.id, file: incident.file, sha256: incident.expected }] }));
const sig = signBytes(catalog, b64.decode(keys.secretKey));
const decide = (bytes = source, remote = old, manifest = catalog, signature = sig) => recoveryDecision(manifest, signature, [keys.publicKey], incident, bytes, remote);
assert.equal(decide(), "restore");
assert.equal(decide(source, source), "unchanged");
assert.throws(() => decide(Buffer.from("changed source")), /source does not match/);
assert.throws(() => decide(source, Buffer.from("unknown origin")), /unexpected origin/);
assert.throws(() => decide(source, old, catalog, "invalid"), /signature invalid/);
const changed = Buffer.from(catalog.toString().replace(incident.file, "different.r1.json"));
assert.throws(() => decide(source, old, changed, signBytes(changed, b64.decode(keys.secretKey))), /no longer matches/);
const duplicated = JSON.parse(catalog.toString()); duplicated.courses.push(duplicated.courses[0]);
const duplicateBytes = Buffer.from(JSON.stringify(duplicated));
assert.throws(() => decide(source, old, duplicateBytes, signBytes(duplicateBytes, b64.decode(keys.secretKey))), /no longer matches/);
assert.throws(() => recoveryDecision(catalog, sig, [newKeyPair().publicKey], incident, source, old), /signature invalid/);
console.log("course artifact recovery: 8 checks passed");
