import assert from 'node:assert/strict';
import { JSDOM } from 'jsdom';
import { pathToView, viewToPath, pageKey } from '../src/lib/routes.ts';
import { requestNavigation } from '../src/lib/navigationGuard.ts';
const installed = [{ id: 'course', title: 'Synthetic course' }];
for (const kind of ['advanced', 'scientific', 'branching', 'spreadsheet'] as const) {
  const view = { name: 'courseActivity' as const, courseId: 'course', kind, sourceId: 'source / ?%' };
  assert.deepEqual(pathToView(viewToPath(view, installed, () => undefined), '', installed, []), view);
  assert.notEqual(pageKey(view), pageKey({ ...view, sourceId: 'other' }));
}
for (const path of ['/%ZZ/activities/advanced/source', '/%E0%A4/activities/scientific/source', '/synthetic-course/activities/unknown/source', '/synthetic-course/activities/advanced', '/synthetic-course/activities/advanced/%ZZ', '/synthetic-course/activities/advanced/source/extra']) assert.equal(pathToView(path, '', installed, []), null, path);
const dom = new JSDOM('<!doctype html><body><div id="root"></div></body>', { url: 'https://example.test' });
Object.assign(globalThis, { window: dom.window, document: dom.window.document, HTMLElement: dom.window.HTMLElement, localStorage: dom.window.localStorage, IS_REACT_ACT_ENVIRONMENT: true });
Object.defineProperty(globalThis, 'navigator', { value: dom.window.navigator, configurable: true });
const { createElement, act } = await import('react');
const { createRoot } = await import('react-dom/client');
const { default: Assignment } = await import('../src/components/SpreadsheetCourseAssignment.tsx');
const root = createRoot(document.getElementById('root')!);
let resolveSave: (() => void) | undefined;
const api: any = { student: null, progress: {}, updateProgress: () => new Promise<void>(resolve => { resolveSave = resolve; }) };
const assignment = { id: 'sheet', title: 'Synthetic sheet', lessonId: 'lesson', starter: { engineVersion: 2 as const, sheets: { Data: { A1: 1 } } }, answers: { 'Data!A1': 2 }, protectedCells: [] };
let confirms = 0, consent = false;
dom.window.confirm = () => { confirms++; return consent; };
const click = async (label: string) => { const button = [...document.querySelectorAll('button')].find(b => b.textContent?.trim() === label); assert(button, label); await act(async () => button.click()); };
const fill = async (value: string) => { const label = [...document.querySelectorAll("label")].find(l => l.textContent === "Data!A1")!; const input = document.getElementById(label?.htmlFor) as HTMLInputElement; assert(input); await act(async () => { Object.getOwnPropertyDescriptor(dom.window.HTMLInputElement.prototype, 'value')!.set!.call(input, value); input.dispatchEvent(new dom.window.Event('input', { bubbles: true })); }); };
await act(async () => root.render(createElement(Assignment, { api, courseId: 'course', assignment })));
assert.equal(requestNavigation(), true); assert.equal(confirms, 0);
await fill('2');
assert.equal(requestNavigation('app', { name: 'lesson' }), false);
assert.equal(requestNavigation('history'), false);
let event = new dom.window.Event('beforeunload', { cancelable: true }); dom.window.dispatchEvent(event); assert(event.defaultPrevented);
consent = true; assert.equal(requestNavigation(), true); consent = false;
await click('Apply cell edit');
const confirmed = confirms; assert.equal(requestNavigation(), true); assert.equal(confirms, confirmed, 'saved drafts do not trigger false discard prompts');
const original = dom.window.Storage.prototype.setItem;
dom.window.Storage.prototype.setItem = () => { throw Error('Synthetic quota failure'); };
await fill('3'); await click('Apply cell edit');
assert.equal(requestNavigation(), false, 'failed autosave protects the in-memory workbook');
dom.window.Storage.prototype.setItem = original;
await click('Retry save'); assert.equal(requestNavigation(), true);
await click('Grade assignment'); assert(resolveSave);
const beforeBusy = confirms; assert.equal(requestNavigation(), false, 'in-flight save blocks leaving'); assert.equal(confirms, beforeBusy, 'cannot confirm past an in-flight save');
await act(async () => resolveSave!()); assert.equal(requestNavigation(), true);
await fill('4'); await click('Discard cell edit'); assert.equal(requestNavigation(), true);
await act(async () => root.unmount()); assert.equal(requestNavigation(), true, 'unmount releases guard');
dom.window.close();
console.log('Activity routes and spreadsheet pending-edit, failed-save, in-flight and history navigation guards passed');
