import assert from 'node:assert/strict';
import { documentJSON, emptyDocumentTemplate, parseDocumentTemplate, importDocumentTemplate, exportDocumentTemplate, parseCaseAssignment, emptyDocumentResponse, parseDocumentResponse, parseDocumentDraft, makeDocumentSubmission, parseDocumentSubmission, parseDocumentFeedback, emptyDocumentLibrary, parseDocumentLibrary, compareDocumentSubmissions, type DocumentTemplate, type CaseAssignment, type DocumentResponse } from '../src/lib/documentEngine.ts';
const at='2026-10-29T06:00:00.000Z';
const later='2026-10-29T07:00:00.000Z';
const template:DocumentTemplate={...emptyDocumentTemplate('source'),revision:1,pages:[{id:'p1',title:'Synthetic page',text:'Synthetic source evidence only.'}],fields:[
 {id:'short',pageId:'p1',label:'Short',kind:'text',required:true,maxLength:10,anchor:{x:0,y:0,width:1,height:0.1}},
 {id:'long',pageId:'p1',label:'Long',kind:'longtext',required:false},
 {id:'amount',pageId:'p1',label:'Amount',kind:'number',required:true,min:0,max:10},
 {id:'day',pageId:'p1',label:'Day',kind:'date',required:true},
 {id:'check',pageId:'p1',label:'Check',kind:'checkbox',required:true},
 {id:'choice',pageId:'p1',label:'Choice',kind:'select',required:true,options:['A','B']},
],approval:{at,actor:'Teacher'}};
const assignment:CaseAssignment={id:'case1',revision:1,studentId:'learner1',title:'Synthetic case',instructions:'Practice only.',documents:[template],createdAt:at};
const response:DocumentResponse={values:{source:{short:'Answer',long:'Long answer',amount:0,day:'2024-02-29',check:true,choice:'A'}},annotations:[{id:'a1',documentId:'source',pageId:'p1',note:'Synthetic note',quote:{start:0,end:9,text:'Synthetic'}},{id:'a2',documentId:'source',pageId:'p1',note:'Overlay',anchor:{x:0.5,y:0.5,width:0.5,height:0.5}}]};
let count=0;const check=(name:string,fn:()=>void)=>{fn();count++;console.log('ok',name);};
const bad=(fn:()=>unknown)=>assert.throws(fn,/Invalid educational document/);
const copy=<T>(v:T):T=>JSON.parse(JSON.stringify(v));
check('template strict round trip and detached parsing',()=>{const parsed=parseDocumentTemplate(JSON.stringify(template));assert.deepEqual(parsed,template);parsed.pages[0].text='changed';assert.notEqual(parsed.pages[0].text,template.pages[0].text);});
check('imports and exports cannot convey approval',()=>{const imported=importDocumentTemplate(template,'newsource');assert.equal(imported.id,'newsource');assert.equal(imported.revision,0);assert.equal(imported.approval,undefined);assert.equal(JSON.parse(exportDocumentTemplate(template)).approval,undefined);bad(()=>parseDocumentTemplate({...template,revision:0}));});
check('all field types and draft/complete distinction',()=>{assert.deepEqual(parseDocumentResponse(response,assignment,true),response);assert.deepEqual(parseDocumentResponse(emptyDocumentResponse(),assignment),emptyDocumentResponse());bad(()=>parseDocumentResponse(emptyDocumentResponse(),assignment,true));for(const [key,value] of [['short','too long text'],['amount',11],['amount','1'],['day','2025-02-29'],['day','2024-13-01'],['choice','C'],['check','true']]){const r=copy(response);r.values.source[key as string]=value;bad(()=>parseDocumentResponse(r,assignment,true));}const r=copy(response);r.values.source.check=false;parseDocumentResponse(r,assignment);bad(()=>parseDocumentResponse(r,assignment,true));});
check('unknown fields and source identities rejected',()=>{bad(()=>parseDocumentResponse({...response,values:{source:{unknown:'x'}}},assignment));bad(()=>parseDocumentResponse({...response,values:{missing:{}}},assignment));bad(()=>parseCaseAssignment({...assignment,documents:[{...template,approval:undefined}]}));bad(()=>parseCaseAssignment({...assignment,documents:[template,template]}));});
check('exact quote and normalized anchors are enforced',()=>{for(const quote of [{start:0,end:9,text:'synthetic'},{start:9,end:0,text:'Synthetic'},{start:0,end:999,text:'Synthetic'}])bad(()=>parseDocumentResponse({...response,annotations:[{...response.annotations[0],quote}]},assignment));for(const anchor of [{x:0.9,y:0,width:0.2,height:0.2},{x:0,y:0,width:0,height:1},{x:0,y:-1,width:1,height:1}])bad(()=>parseDocumentResponse({...response,annotations:[{...response.annotations[1],anchor}]},assignment));bad(()=>parseDocumentResponse({...response,annotations:[{id:'a',documentId:'source',pageId:'p1',note:'No anchor'}]},assignment));bad(()=>parseDocumentResponse({...response,annotations:[response.annotations[0],response.annotations[0]]},assignment));});
const submission=makeDocumentSubmission(assignment,response,'s1',later);
check('submitted evidence is detached from mutable input',()=>{const a=copy(assignment),r=copy(response),s=makeDocumentSubmission(a,r,'s2',later);a.documents[0].pages[0].text='mutated';r.values.source.short='mutated';assert.equal(s.assignment.documents[0].pages[0].text,template.pages[0].text);assert.equal(s.response.values.source.short,'Answer');bad(()=>parseDocumentSubmission({...s,studentId:'someoneelse'}));bad(()=>parseDocumentSubmission({...s,submittedAt:'2025-01-01T00:00:00Z'}));});
const feedback={id:'feedback1',submissionId:'s1',at:later,actor:'Teacher',status:'needs_revision' as const,note:'Review the highlighted source.'};
const library={...emptyDocumentLibrary(),templates:[template],assignments:[assignment],drafts:[{caseId:'case1',caseRevision:1,revision:0,response:emptyDocumentResponse(),updatedAt:later}],submissions:[submission],feedback:[feedback]};
check('complete library lifecycle round trip',()=>{assert.deepEqual(parseDocumentLibrary(JSON.stringify(library)),library);assert.deepEqual(parseDocumentLibrary(null),emptyDocumentLibrary());assert.deepEqual(parseDocumentFeedback(feedback),feedback);parseDocumentDraft(library.drafts[0],assignment);});
check('source and assignment snapshots cannot drift',()=>{const l=copy(library);l.templates[0].pages[0].text='different';bad(()=>parseDocumentLibrary(l));const m=copy(library);m.submissions[0].assignment.instructions='changed';bad(()=>parseDocumentLibrary(m));bad(()=>parseDocumentLibrary({...library,templates:[]}));bad(()=>parseDocumentLibrary({...library,assignments:[]}));});
check('identity collisions, tombstones and orphan feedback rejected',()=>{bad(()=>parseDocumentLibrary({...library,templates:[template,template]}));bad(()=>parseDocumentLibrary({...library,submissions:[submission,submission]}));bad(()=>parseDocumentLibrary({...library,deletedStudentIds:['learner1']}));bad(()=>parseDocumentLibrary({...library,feedback:[{...feedback,submissionId:'missing'}]}));bad(()=>parseDocumentLibrary({...library,feedback:[{...feedback,at:'2025-01-01T00:00:00Z'}]}));bad(()=>parseDocumentLibrary({...library,assignments:[assignment,{...assignment,revision:2,studentId:'other'}]}));bad(()=>parseDocumentDraft({...library.drafts[0],caseRevision:2},assignment));});
check('multi-document and versioned source histories retain exact evidence',()=>{const second={...template,id:'second'};const next={...template,revision:2,pages:[{...template.pages[0],text:'Revised synthetic source.'}]};const a={...assignment,revision:2,documents:[next,second]};const r={values:{source:response.values.source,second:response.values.source},annotations:[]};const s=makeDocumentSubmission(a,r,'s2',later);parseDocumentLibrary({...library,templates:[template,next,second],assignments:[assignment,a],submissions:[submission,s]});const changes=compareDocumentSubmissions(submission,s);assert.ok(changes.some(x=>x.path==='Source source'));assert.ok(changes.some(x=>x.path==='Source second'));assert.ok(changes.some(x=>x.path==='Annotation a1'));});
check('comparison is deterministic and does not invent grades',()=>{assert.deepEqual(compareDocumentSubmissions(submission,submission),[]);const r=copy(response);r.values.source.short='Revised';const s=makeDocumentSubmission(assignment,r,'s2',later);assert.deepEqual(compareDocumentSubmissions(submission,s),[{path:'Field source/short',before:'Answer',after:'Revised'}]);bad(()=>compareDocumentSubmissions(submission,makeDocumentSubmission({...assignment,id:'other'},r,'s3',later)));bad(()=>parseDocumentFeedback({...feedback,grade:10}));});
check('strict JSON transport rejects dangerous/unsupported structures',()=>{bad(()=>parseDocumentTemplate('{'));bad(()=>parseDocumentTemplate({...template,extra:true}));bad(()=>parseDocumentTemplate({...template,pages:[{...template.pages[0],text:'bad\u0000'}]}));bad(()=>documentJSON(JSON.parse('{"__proto__":{}}')));bad(()=>documentJSON({value:NaN}));bad(()=>documentJSON(new Date()));bad(()=>documentJSON({value:undefined}));const cyclic:any={};cyclic.self=cyclic;bad(()=>documentJSON(cyclic));let deep:any={};for(let n=0;n<40;n++)deep={deep};bad(()=>documentJSON(deep));bad(()=>documentJSON(new Array(2)));bad(()=>parseDocumentTemplate({...template,title:'x'.repeat(301)}));bad(()=>parseDocumentTemplate({...template,fields:[{...template.fields[0],pageId:'missing'}]}));assert.equal(documentJSON({b:1,a:2}),'{"a":2,"b":1}');});
check('restored source quarantine preserves history and validates references',()=>{const restored={...library,restoredAt:later,pendingApproval:['source@1']};assert.deepEqual(parseDocumentLibrary(restored),restored);bad(()=>parseDocumentLibrary({...restored,restoredAt:'not a date'}));bad(()=>parseDocumentLibrary({...restored,pendingApproval:['missing@1']}));bad(()=>parseDocumentLibrary({...restored,pendingApproval:['source@1','source@1']}));});
console.log(`${count} educational document model checks passed`);
