import assert from 'node:assert/strict';
import {JSDOM} from 'jsdom';
import {emptyCourse} from '../src/lib/course.ts';
const dom=new JSDOM('<!doctype html><body><div id="root"></div></body>',{url:'https://example.test'});
Object.assign(globalThis,{window:dom.window,document:dom.window.document,HTMLElement:dom.window.HTMLElement,localStorage:dom.window.localStorage,IS_REACT_ACT_ENVIRONMENT:true});Object.defineProperty(globalThis,'navigator',{value:dom.window.navigator,configurable:true});
const {createElement,act}=await import('react');const {createRoot}=await import('react-dom/client');const {default:Editor}=await import('../src/components/CourseAdvancedAssessmentEditor.tsx');
const root=createRoot(document.getElementById('root')!);let course=emptyCourse('Test'),pending=false;course.lessons=[{id:'intro',title:'Test',module:course.modules[0].id,body:''}];
const render=()=>root.render(createElement(Editor,{course,update:fn=>{course=fn(course);render();},onEditingChange:v=>{pending=v;}}));await act(async()=>render());
const click=async(t:string)=>{const b=[...document.querySelectorAll('button')].find(b=>b.textContent?.trim()===t);assert(b,t);await act(async()=>b.click());};
const fill=async(label:string,v:string)=>{const el=document.querySelector(`[aria-label="${label}"]`) as HTMLInputElement;assert(el,label);const proto=el.tagName==='SELECT'?dom.window.HTMLSelectElement.prototype:el.tagName==='TEXTAREA'?dom.window.HTMLTextAreaElement.prototype:dom.window.HTMLInputElement.prototype;await act(async()=>{Object.getOwnPropertyDescriptor(proto,'value')!.set!.call(el,v);el.dispatchEvent(new dom.window.Event(el.tagName==='SELECT'?'change':'input',{bubbles:true}));});};
await click('Add advanced assessment');assert(pending);await fill('Assessment title','Synthetic project');await fill('Assessment attached lesson','intro');await click('Apply assessment to course');assert(!pending);assert.equal(course.advancedAssessments?.[0].title,'Synthetic project');assert.equal(course.advancedAssessments?.[0].revision,1);assert.equal(course.advancedAssessments?.[0].lessonId,'intro');
await click('Edit assessment Synthetic project');await fill('Assessment title','Unsaved edit');await click('Discard assessment draft');assert.equal(course.advancedAssessments?.[0].title,'Synthetic project');assert(!pending);
await click('Edit assessment Synthetic project');await fill('Variant 1 ID','invalid id');await click('Apply assessment to course');assert(document.querySelector('[role="alert"]'));assert(pending,'invalid definition stays editable');assert.equal(course.advancedAssessments?.[0].variants.length,1);
await click('Discard assessment draft');await click('Edit assessment Synthetic project');await fill('Assessment instructions','Changed reviewed source');await click('Apply assessment to course');assert.equal(course.advancedAssessments?.[0].revision,2);assert.equal(course.advancedAssessments?.[0].instructions,'Changed reviewed source');

await click('Edit assessment Synthetic project');await fill('Variant 1 question 1 step 1 feedback mode','number');await fill('Variant 1 question 1 step 1 expected number','4');await fill('Variant 1 question 1 step 1 absolute tolerance','0.01');await click('Add misconception');await fill('Misconception 1 ID','pattern');await click('Add response pattern to variant 1 question 1 step 1');await fill('Variant 1 question 1 step 1 pattern 1 responses (one per line)','5');await fill('Rubric revision','2');await fill('Criterion 1 level 2 description','Clear evidence and explanation');await click('Add question variant');await fill('Variant 2 title','Alternative oral prompt');await click('Apply assessment to course');assert.equal(course.advancedAssessments?.[0].variants.length,2);assert.equal(course.advancedAssessments?.[0].rubric.revision,2);const saved=structuredClone(course.advancedAssessments![0]);await click('Edit assessment Synthetic project');await click('Discard assessment draft');assert.deepEqual(course.advancedAssessments![0],saved);
await click('Remove assessment Synthetic project');await click('Keep assessment');assert.equal(course.advancedAssessments?.length,1);await click('Remove assessment Synthetic project');await click('Confirm assessment removal');assert.equal(course.advancedAssessments?.length,0);
await act(async()=>root.unmount());console.log('Advanced assessment course UI authoring passed');
