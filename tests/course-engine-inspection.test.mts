import assert from 'node:assert/strict';
import { createHash } from 'node:crypto';
import { JSDOM } from 'jsdom';
import { emptyAdvancedAssessmentPack } from '../src/lib/advancedAssessment.ts';
import { emptyScientificPack } from '../src/lib/scientificWorkspace.ts';
import { emptyBranchingPack } from '../src/lib/branchingEngine.ts';
const dom = new JSDOM('<!doctype html><body><div id="root"></div></body>', { url: 'https://example.test' });
Object.assign(globalThis, { window: dom.window, document: dom.window.document, HTMLElement: dom.window.HTMLElement, IS_REACT_ACT_ENVIRONMENT: true });
const { createElement, act } = await import('react');
const { createRoot } = await import('react-dom/client');
const { default: Inspection, engineInspectionJSON } = await import('../src/components/CourseEngineInspection.tsx');
const root = createRoot(document.getElementById('root')!);
const advanced = { ...emptyAdvancedAssessmentPack('assessment'), revision: 3, lessonId: 'lesson-a' };
advanced.title = '<img src=x onerror=alert(1)>';
const scientific = { ...emptyScientificPack('science'), revision: 2, lessonId: 'lesson-b' };
const branching = { ...emptyBranchingPack('scenario'), revision: 4 };
const spreadsheet = { id: 'sheet', title: 'Synthetic sheet', lessonId: 'lesson-a', starter: { engineVersion: 2 as const, sheets: { Data: { A1: 3, A2: '=A1+2' } }, macroDefinitions: [{ id: 'fill', title: 'Fill', steps: [{ op: 'set' as const, target: 'Data!A1', value: 7 }] }] }, answers: { 'Data!A2': 5 }, protectedCells: ['Data!A1'] };
const sources = { advancedAssessments: [advanced], scientificWorkspaces: [scientific], branchingScenarios: [branching], spreadsheetAssignments: [spreadsheet] };
const before = structuredClone(sources);
await act(async () => { root.render(createElement(Inspection, { sources })); await new Promise(r => setTimeout(r, 20)); });
await act(async () => { await new Promise(r => setTimeout(r, 20)); });
const text = document.body.textContent!;
for (const label of ['lesson-a', 'lesson-b', 'Source revision: 3', 'Source revision: 2', 'Source revision: 4', 'Adult handoff:', 'not the signed package digest', 'Explicit variants', 'Safety and model assumptions', 'Decisions and consequences', 'Declarative macros (not run)', 'Set Data!A1 to 7']) assert(text.includes(label), label);
assert(text.includes(createHash('sha256').update(engineInspectionJSON(advanced)).digest('hex')));
assert.equal(document.querySelectorAll('img').length, 0, 'authored text is never interpreted as HTML');
assert.equal(document.querySelectorAll('button, input, select').length, 0, 'inspection never approves or assigns');
assert.deepEqual(sources, before, 'inspection never executes formulas/macros or edits sources');
assert.equal(engineInspectionJSON({ a: 1, b: [2, 3] }), engineInspectionJSON({ b: [2, 3], a: 1 }));
const oldDigest = createHash('sha256').update(engineInspectionJSON(advanced)).digest('hex');
const revised = { ...advanced, title: 'New exact source', revision: 4 };
await act(async () => { root.render(createElement(Inspection, { sources: { advancedAssessments: [revised] } })); });
await act(async () => { await new Promise(r => setTimeout(r, 20)); });
assert(!document.body.textContent!.includes(oldDigest), 'changed source cannot display the old fingerprint');
assert(document.body.textContent!.includes(createHash('sha256').update(engineInspectionJSON(revised)).digest('hex')));
await act(async () => { root.render(createElement(Inspection, { sources: {} })); });
assert.equal(document.getElementById('root')!.textContent, '');
await act(async () => root.unmount());
console.log('Course engine inspection read-only UI and exact fingerprints passed');
