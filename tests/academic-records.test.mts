import assert from 'node:assert/strict';
import { webcrypto } from 'node:crypto';
import { emptyAcademicRecords, parseAcademicRecords, saveCreditClaim, removeCreditClaim, auditAcademicRecords, exportAcademicRecords, previewAcademicImport, applyAcademicImport, previewAcademicRetention, applyAcademicRetention, restoreAcademicRecords, type CreditClaim } from '../src/lib/academicRecords.ts';
if (!globalThis.crypto) Object.defineProperty(globalThis,'crypto',{value:webcrypto});
const now = '2026-10-30T12:00:00.000Z';
const credit = (id='one', extra:Partial<CreditClaim>={}): CreditClaim => ({id,title:'Algebra',subject:'Mathematics',date:'2026-06-10',credits:1,evidence:'Parent reviewed work sample',note:'',sourceKey:'outside:algebra',origin:'local',reviewed:true,provenance:'Parent-entered statement',updatedAt:now,...extra});
let state = emptyAcademicRecords();
state.policy = {name:'Family plan',totalCredits:2,requirements:[{id:'math',subject:'Mathematics',credits:2,requireEvidence:true}]};
state=saveCreditClaim(state,credit());
assert.equal(auditAcademicRecords(state).totalCredits,1);
assert.equal(auditAcademicRecords(state).requirements[0].remaining,1);
assert.equal(auditAcademicRecords(state).planningRequirementsMet,false);
const candidate={key:'outside:algebra',title:'Algebra original',subject:'Mathematics',credits:1,eligible:true,evidence:'Local transcript',provenance:'Family statement'};
assert.equal(auditAcademicRecords(state,[candidate]).totalCredits,1,'linked corrections never double count');
assert.throws(()=>saveCreditClaim(state,credit('two')),/already recorded/);
assert.throws(()=>saveCreditClaim(state,credit('two',{sourceKey:'different'})),/already recorded/);
assert.throws(()=>parseAcademicRecords({...state,claims:[credit(),credit('two')]}),/Duplicate/);
assert.equal(saveCreditClaim(emptyAcademicRecords(),credit('trim',{sourceKey:' course:math '})).claims[0].sourceKey,'course:math');
state=saveCreditClaim(state,credit('one',{credits:2}));
assert.equal(auditAcademicRecords(state).planningRequirementsMet,true);
assert.equal(auditAcademicRecords(saveCreditClaim(state,credit('one',{evidence:''}))).totalCredits,0);
assert.equal(auditAcademicRecords(saveCreditClaim(state,credit('one',{reviewed:false}))).totalCredits,0);
assert.throws(()=>saveCreditClaim(state,credit('bad',{date:'2026-02-30'})),/real/);
assert.throws(()=>saveCreditClaim(state,credit('bad',{credits:Infinity})),/finite/);
assert.throws(()=>parseAcademicRecords({...state,claims:{}}),/entries/);
assert.throws(()=>parseAcademicRecords(JSON.parse('{"version":1,"__proto__":{}}')),/Unsafe/);
assert.throws(()=>parseAcademicRecords({...state,policy:{...state.policy,requirements:[...state.policy.requirements,{id:'second',subject:' mathematics ',credits:1,requireEvidence:false}]}}),/Duplicate/);
const text=exportAcademicRecords(state,now,'Synthetic family report',[{...candidate,key:'course:biology',title:'Biology',subject:'Science'}],'Attendance: 12 confirmed days; transcript statements are unverified.');
const preview=await previewAcademicImport(text);
assert.equal(preview.claims.length,2);
assert.match(preview.summary,/Attendance/);
let seq=0;
const imported=applyAcademicImport(emptyAcademicRecords(),preview,now,()=>`new${++seq}`);
assert.deepEqual(imported.claims.map(c=>c.reviewed),[false,false]);
assert.equal(imported.policy.totalCredits,0,'import does not overwrite local graduation policy');
assert.equal(auditAcademicRecords(imported).totalCredits,0);
assert.match(imported.imports[0].summary!,/Attendance/);
const forwarded = await previewAcademicImport(exportAcademicRecords(imported,now));
assert.equal(forwarded.archives.length,1);
assert.match(forwarded.archives[0].summary,/Attendance/);
const forwardedImport=applyAcademicImport(emptyAcademicRecords(),forwarded,now,()=>`next${++seq}`);
assert.match(forwardedImport.imports[0].summary!,/Attendance/);
assert.throws(()=>applyAcademicImport(emptyAcademicRecords(),preview,now,()=>`next${++seq}`,[candidate]),/already exists/);
assert.throws(()=>applyAcademicImport(imported,preview,now,()=>`new${++seq}`),/already been imported/);
const identical=await previewAcademicImport(JSON.stringify({...JSON.parse(text),exportedAt:'2027-01-01T00:00:00Z'},null,4));
assert.equal(identical.fingerprint,preview.fingerprint,'re-export time and formatting are not new evidence');
const reviewed=saveCreditClaim(imported,{...imported.claims[0],reviewed:true,origin:'local',provenance:'Verified university'});
assert.equal(reviewed.claims[0].origin,'imported');
assert.match(reviewed.claims[0].provenance,/Unverified import/);
assert.equal(auditAcademicRecords(reviewed).totalCredits,2,'explicit parent review counts only local planning credits');
const cleanup=previewAcademicRetention(imported,'2026-07-01');
assert.equal(cleanup.ids.length,1);
assert.equal(applyAcademicRetention(imported,cleanup).claims.length,1);
assert.equal(applyAcademicRetention(imported,cleanup).imports.length,1,'retain replay ledger and archive provenance');
assert.throws(()=>applyAcademicRetention(reviewed,cleanup),/changed/);
assert.throws(()=>applyAcademicRetention(imported,{...cleanup,ids:[]}),/selection/);
assert.equal(removeCreditClaim(state,'one').claims.length,0);
assert.equal(restoreAcademicRecords(state).claims[0].reviewed,false);
assert.equal(restoreAcademicRecords(state).claims[0].origin,'imported');
const restoredAudit=auditAcademicRecords(restoreAcademicRecords(state),[candidate]);
assert.equal(restoredAudit.totalCredits,1,'unreviewed imported correction cannot suppress original existing candidate');
assert.equal(restoredAudit.entries[1].claimId,'one');
await assert.rejects(()=>previewAcademicImport('x'.repeat(2*1024*1024+1)),/2 MiB/);
await assert.rejects(()=>previewAcademicImport(JSON.stringify({format:'other',version:1})),/Choose/);
assert.throws(()=>applyAcademicImport(state,preview,now,()=>`new${++seq}`),/already recorded/);
assert.throws(()=>exportAcademicRecords(emptyAcademicRecords(),now,'Duplicate source',[candidate,candidate]),/Duplicate/);
// The exact same provenance/header budget is enforced before export, preview and apply.
const archiveLabel='Boundary archive', currentSummary='Current report';
const header=`Prior unverified archive: ${archiveLabel} (imported ${now})\n`;
const boundaryState=emptyAcademicRecords();
boundaryState.imports=[{fingerprint:'a'.repeat(64),importedAt:now,label:archiveLabel,summary:'x'.repeat(200000-currentSummary.length-2-header.length)}];
const boundaryText=exportAcademicRecords(boundaryState,now,'Boundary',[],currentSummary);
const boundaryPreview=await previewAcademicImport(boundaryText);
const boundaryImported=applyAcademicImport(emptyAcademicRecords(),boundaryPreview,now,()=>`boundary${++seq}`);
assert.equal(boundaryImported.imports[0].summary!.length,200000);
assert.throws(()=>exportAcademicRecords(boundaryState,now,'Boundary',[],currentSummary+'x'),/Combined historical summary/);
const hostileBoundary=JSON.parse(boundaryText); hostileBoundary.summary+='x';
await assert.rejects(()=>previewAcademicImport(JSON.stringify(hostileBoundary)),/Combined historical summary/);
assert.throws(()=>applyAcademicImport(emptyAcademicRecords(),{...boundaryPreview,summary:currentSummary+'x'},now,()=>`boundary${++seq}`),/Combined historical summary/);
// Individual archive limits alone are insufficient: the accumulated export must fail first.
assert.throws(()=>exportAcademicRecords(boundaryState,now,'Boundary',[],'y'.repeat(200000)),/Combined historical summary/);
console.log('Academic planning policy, evidence, duplicate/correction, provenance, portable import and retention tests passed.');
