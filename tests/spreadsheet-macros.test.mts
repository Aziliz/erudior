import assert from 'node:assert/strict';
import { type Workbook } from '../src/lib/spreadsheet.ts';
import { validateWorkbook } from '../src/lib/workbookTemplates.ts';
import { previewWorkbookMacro,applyWorkbookMacro,validateWorkbookMacroTrace } from '../src/lib/spreadsheetMacros.ts';
const book:Workbook={engineVersion:2,sheets:{Practice:{A1:2,B1:0,C1:0}},validationRules:[{sheet:'Practice',range:'B1:C1',kind:'integer',min:0,max:10}],macroDefinitions:[{id:'copy-demo',title:'Copy and calculate',steps:[{op:'copy',source:'Practice!A1',target:'Practice!B1'},{op:'set',target:'Practice!C1',value:'=B1*2'}]}]};
const original=JSON.stringify(book), preview=previewWorkbookMacro(book,'copy-demo',['Practice!A1']);
assert.equal(JSON.stringify(book),original);
assert.equal(preview.workbook.sheets.Practice.B1,2); assert.equal(preview.workbook.sheets.Practice.C1,'=B1*2');
assert.equal(preview.trace.changes.length,2); assert.deepEqual(validateWorkbookMacroTrace(preview.trace,['Practice!A1']),[]);
assert.throws(()=>applyWorkbookMacro(book,preview,['Practice!A1']),/consent/);
assert.deepEqual(applyWorkbookMacro(book,preview,['Practice!A1'],true),preview);
assert.throws(()=>previewWorkbookMacro(book,'copy-demo',['practice!b1']),/protected/);
const changed=structuredClone(book);changed.sheets.Practice.A1=3;assert.throws(()=>applyWorkbookMacro(changed,preview,[],true),/changed/);
const forged=structuredClone(preview);forged.trace.changes[0].after=7;assert.ok(validateWorkbookMacroTrace(forged.trace).length);assert.throws(()=>applyWorkbookMacro(book,forged,[],true));
const forgedBook=structuredClone(preview);forgedBook.workbook.sheets.Practice.B1=9;assert.throws(()=>applyWorkbookMacro(book,forgedBook,[],true));
const invalid=structuredClone(book);invalid.macroDefinitions![0].steps.push({op:'set',target:'Practice!B1',value:-1});assert.throws(()=>previewWorkbookMacro(invalid,'copy-demo'),/validation/);assert.equal(invalid.sheets.Practice.B1,0);
const cycle=structuredClone(book);cycle.macroDefinitions![0].steps=[{op:'set',target:'Practice!B1',value:'=B1'}];assert.throws(()=>previewWorkbookMacro(cycle,'copy-demo'));
for(const extra of [{op:'eval',code:'process.exit()'},{op:'set',target:'Practice!A1',value:1,script:'evil'},{op:'copy',source:'Missing!A1',target:'Practice!A1'}]) assert.equal(validateWorkbook({...book,macroDefinitions:[{id:'bad',title:'Bad',steps:[extra]}]}),false);
assert.equal(validateWorkbook({...book,macroDefinitions:Array.from({length:21},(_,i)=>({id:'m'+i,title:'x',steps:[{op:'set',target:'Practice!A1',value:0}]}))}),false);
assert.equal(validateWorkbook({...book,macroDefinitions:[{id:'many',title:'x',steps:Array.from({length:51},()=>({op:'set',target:'Practice!A1',value:0}))}]}),false);
const tooLarge=structuredClone(book);for(let i=1;i<=60;i++)tooLarge.sheets.Practice['D'+i]='x'.repeat(1000);assert.throws(()=>previewWorkbookMacro(tooLarge,'copy-demo'),/64 KiB/);
assert.ok(validateWorkbookMacroTrace({...preview.trace,authorized:true}).length);
assert.ok(validateWorkbookMacroTrace({before:book,after:book}).length);
assert.ok(validateWorkbookMacroTrace({get version(){throw Error('bad')}}).length);
assert.throws(()=>previewWorkbookMacro({sheets:book.sheets},'copy-demo'),/version 2/);
console.log('spreadsheet macro preview, consent, atomic safety, replay and bounded traces passed');
