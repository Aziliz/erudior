import assert from "node:assert/strict";
import { classFile, makeHandIn, missingHandInAttachments, verifyHandIn } from "../src/lib/classroom.ts";
import { preparePersistedHandIn } from "../src/lib/classroomExport.ts";
import { newClass, newStudent, type Family } from "../src/lib/family.ts";
import { emptyProgress } from "../src/lib/storage.ts";
const student = newStudent("Learner", 6);
const cls = newClass("Classroom", [student.id]);
cls.assignments = [{ courseId: "science", assigned: "2026-10-01" }];
const family = { students: [student], classes: [cls], mode: "classroom" } as Family;
const course = classFile(family, cls, () => "Science");
const photo = { id: "photo1", fileId: "file1", name: "observation.txt", mime: "text/plain", bytes: 3, caption: "Observation", date: "2026-10-01" };
const progress = { ...emptyProgress(), work: { "science/report": { kind: "writing" as const, started: "2026-10-01T10:00:00.000Z", updated: "2026-10-01T10:00:00.000Z", photos: [photo] } } };
const joined = { cls: course, studentId: student.id };
const io = { activeStudent: () => student.id, loadProgress: async () => progress, loadFile: async () => ({ mime: "text/plain", data: "AQID" }) };
const complete = await preparePersistedHandIn(joined, io);
assert.deepEqual(missingHandInAttachments(complete), []);
assert.equal(complete.files?.file1.data, "AQID");
await verifyHandIn(complete, family);
await assert.rejects(preparePersistedHandIn(joined, { ...io, loadFile: async () => null }), /missing/);
await assert.rejects(preparePersistedHandIn(joined, { ...io, loadFile: async () => { throw Error("storage read failed"); } }), /storage read failed/);
await assert.rejects(preparePersistedHandIn(joined, { ...io, loadFile: async () => ({ mime: "text/plain", data: "AQ==" }) }), /metadata mismatch/);
let active = student.id;
await assert.rejects(preparePersistedHandIn(joined, { ...io, activeStudent: () => active, loadFile: async () => { active = "different"; return null; } }), /active learner changed/);
const legacy = await makeHandIn(course, student.id, progress);
await verifyHandIn(legacy, family);
assert.deepEqual(missingHandInAttachments(legacy), ["file1"], "legacy evidence remains inspectable but must be flagged before review");
const legacyFailure = await makeHandIn(course, student.id, progress, async () => { throw Error("legacy absent"); });
assert.deepEqual(missingHandInAttachments(legacyFailure), ["file1"]);
await assert.rejects(makeHandIn(course, student.id, progress, undefined, { requireAttachments: true }), /unavailable/);
await assert.rejects(verifyHandIn(complete, { ...family, students: [] }), /profile no longer exists/, "stale roster cannot resurrect deleted profile");
const noFiles = await preparePersistedHandIn(joined, { ...io, loadProgress: async () => emptyProgress(), loadFile: async () => { throw Error("must not load unrelated files"); } });
assert.deepEqual(missingHandInAttachments(noFiles), []);
console.log("strict hand-in attachment export, legacy detection and deleted-profile tests passed");
