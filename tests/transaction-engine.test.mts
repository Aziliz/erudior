import assert from 'node:assert/strict';
import {
  parseTransactionPack, parseTransactionAssignment, parseTransactionSession, parseTransactionLibrary,
  emptyTransactionSession, emptyTransactionLibrary, applyTransactionCommand, replayTransaction,
  makeTransactionSubmission, parseTransactionSubmission, importTransactionPack, exportTransactionPack,
  parseMinorUnits, formatMinorUnits, transactionDocumentAssignment,
  type TransactionPack, type TransactionCommand,
} from '../src/lib/transactionEngine';
const at='2026-10-29T10:00:00.000Z';
const source={format:'erudior-document-template',version:1,id:'form',revision:1,title:'Synthetic reviewed source',sourceNote:'Test-only source',licenseNote:'Synthetic test permission',pages:[{id:'page',title:'Source page',text:'Synthetic transaction evidence text.'}],fields:[{id:'reason',pageId:'page',label:'Reasoning',kind:'text',required:true}]} as const;
const pack:TransactionPack=parseTransactionPack({format:'erudior-transaction-pack',version:1,id:'pack',revision:1,title:'Synthetic simulation rules',jurisdiction:{id:'synthetic',name:'Fictional jurisdiction',version:'test-v1',sourceNote:'Synthetic test-only rules, no legal authority.',effectiveFrom:'2026-01-01',effectiveThrough:'2026-12-31'},currency:'USD',minorUnitDigits:2,documents:[source],formRoles:[{documentId:'form',role:'Synthetic contract and reasoning'}],clients:[{id:'alicefund',name:'Fictional client A'},{id:'bobfund',name:'Fictional client B'}],contingencies:[{id:'title',title:'Synthetic title check',category:'title',dueDays:5,required:true,allowWaiver:false},{id:'inspection',title:'Synthetic inspection check',category:'inspection',dueDays:5,required:true,allowWaiver:true},{id:'finance',title:'Synthetic financing check',category:'financing',dueDays:5,required:true,allowWaiver:false}],rules:{requireRepresentation:true,requireDocumentsForClose:true,requireReconciliationForClose:true,requireZeroTrustForArchive:true,minEarnestBasisPoints:100,depositDueDays:2},approval:{at,actor:'Synthetic supervising adult'}});
const assignment=parseTransactionAssignment({id:'case',revision:1,studentId:'alice',title:'Synthetic case',instructions:'Test the entire educational workflow.',startDate:'2026-10-29',pack,createdAt:at});
const answer={values:{form:{reason:'Synthetic reason'}},annotations:[]};
let n=0;
function fixture(a=assignment){let session=emptyTransactionSession(a);return {get session(){return session;},setResponse(response:any){session=parseTransactionSession({...session,response,revision:session.revision+1},a);},command(command:TransactionCommand){session=applyTransactionCommand(a,session,command,'event'+(++n),new Date(Date.parse(at)+n*1000).toISOString());return session;},state(){return replayTransaction(a,session.events,session.response);}};}
function prepare(f:ReturnType<typeof fixture>){for(const stage of ['representation','pricing','offer'] as const)f.command({kind:'stage',stage,note:'Reviewed synthetic stage'});}
function offer(f:ReturnType<typeof fixture>,id='offer1'){f.command({kind:'offer',offerId:id,party:'buyer',clientId:'alicefund',price:100000,earnest:1000,expiresOn:'2026-10-31',closingDate:'2026-11-05',note:'Synthetic initial terms'});}
function accepted(){const f=fixture();prepare(f);offer(f);f.command({kind:'accept',offerId:'offer1',party:'seller',note:'Explicit educational acceptance'});return f;}
const tests:Record<string,()=>void>={
 'exact decimal money and safe bounds':()=>{assert.equal(parseMinorUnits('123.45'),12345);assert.equal(parseMinorUnits('1',0),1);assert.equal(parseMinorUnits('1.2345',4),12345);assert.equal(formatMinorUnits(-3,2),'-0.03');for(const x of ['1e3','1.001','-1','NaN','Infinity','1,000','9007199254740992'])assert.throws(()=>parseMinorUnits(x));assert.throws(()=>parseMinorUnits('1.0',0));assert.throws(()=>parseMinorUnits('9'.repeat(10000)));},
 'strict pack schema, dates, roles and inert imported approval':()=>{assert.equal(parseTransactionPack(pack).id,'pack');assert.throws(()=>parseTransactionPack({...pack,documents:[{...source,revision:0}]}),'Unsaved source versions cannot be invented');assert.throws(()=>parseTransactionPack({...pack,jurisdiction:{...pack.jurisdiction,effectiveFrom:'2026-02-30'}}));assert.throws(()=>parseTransactionPack({...pack,rules:{...pack.rules,script:'execute()'}}));assert.throws(()=>parseTransactionPack({...pack,formRoles:[]}));const imported=importTransactionPack(pack,'new');assert.equal(imported.approval,undefined);assert.equal(imported.revision,0);assert.equal(JSON.parse(exportTransactionPack(pack)).approval,undefined);assert.throws(()=>parseTransactionAssignment({...assignment,pack:imported}));assert.throws(()=>parseTransactionAssignment({...assignment,startDate:'2027-01-01'}));},
 'document adapters use exact pack review not imported authority':()=>{const a=transactionDocumentAssignment(assignment);assert.equal(a.documents[0].pages[0].text,source.pages[0].text);assert.equal(a.documents[0].approval?.actor,pack.approval?.actor);a.documents[0].pages[0].text='changed';assert.equal(assignment.pack.documents[0].pages[0].text,source.pages[0].text);},
 'full counteroffer lineage, closing, settlement and archive':()=>{const f=fixture();prepare(f);offer(f);f.command({kind:'offer',offerId:'counter',parentOfferId:'offer1',party:'seller',clientId:'alicefund',price:110000,earnest:1100,expiresOn:'2026-10-31',closingDate:'2026-11-05',note:'Counter with complete revised terms'});assert.throws(()=>f.command({kind:'accept',offerId:'offer1',party:'seller',note:'Cannot accept superseded terms'}));f.command({kind:'accept',offerId:'counter',party:'buyer',note:'Accept exact counteroffer'});for(const contingencyId of ['title','inspection','finance'])f.command({kind:'contingency',contingencyId,status:'satisfied',note:'Synthetic evidence reviewed'});f.setResponse(answer);f.command({kind:'deposit',entryId:'deposit',clientId:'alicefund',amount:1100,reference:'dep1',note:'Deposit synthetic earnest'});f.command({kind:'reconcile',bankBalance:0,outstandingEntryIds:['deposit'],reportedClientBalances:{alicefund:1100,bobfund:0},note:'Deposit in transit'});assert.deepEqual(f.state().reconciliation?.issues,[]);f.command({kind:'stage',stage:'closing',note:'Close reviewed educational case'});assert.throws(()=>f.command({kind:'stage',stage:'archived',note:'Cannot abandon client funds'}));f.command({kind:'disburse',entryId:'payout',clientId:'alicefund',amount:1100,reference:'pay1',note:'Synthetic settlement'});assert.throws(()=>f.command({kind:'stage',stage:'archived',note:'Old reconciliation is stale'}));f.command({kind:'reconcile',bankBalance:0,outstandingEntryIds:[],reportedClientBalances:{alicefund:0,bobfund:0},note:'Settlement reconciled'});f.command({kind:'stage',stage:'archived',note:'Archive retained case'});assert.equal(f.state().outcome,'closed');assert.equal(f.state().stage,'archived');assert.equal(f.state().offers[0].status,'superseded');assert.throws(()=>f.command({kind:'clock',date:'2026-11-06',note:'Archived is immutable'}));assert.throws(()=>f.setResponse({values:{form:{reason:'Edited after archive'}},annotations:[]}));},
 'opposite party acceptance, withdrawal, rejection and expiry':()=>{const f=fixture();prepare(f);offer(f);assert.throws(()=>f.command({kind:'accept',offerId:'offer1',party:'buyer',note:'Self acceptance rejected'}));assert.throws(()=>f.command({kind:'withdraw',offerId:'offer1',party:'seller',note:'Wrong withdrawing party'}));f.command({kind:'reject',offerId:'offer1',party:'seller',note:'Decline terms'});offer(f,'offer2');f.command({kind:'withdraw',offerId:'offer2',party:'buyer',note:'Withdraw own terms'});offer(f,'offer3');f.command({kind:'clock',date:'2026-11-01',note:'Advance fictional clock'});assert.equal(f.state().offers[2].status,'expired');assert.throws(()=>f.command({kind:'accept',offerId:'offer3',party:'seller',note:'Cannot accept expired terms'}));assert.throws(()=>f.command({kind:'clock',date:'2026-10-30',note:'No backwards clock'}));assert.throws(()=>f.command({kind:'clock',date:'2027-01-01',note:'Outside reviewed source interval'}));},
 'contingency waiver, adverse failure and deadlines':()=>{const f=accepted();assert.throws(()=>f.command({kind:'contingency',contingencyId:'title',status:'waived',note:'Prohibited waiver'}));f.command({kind:'contingency',contingencyId:'inspection',status:'waived',note:'Authored waiver permitted'});f.command({kind:'clock',date:'2026-11-04',note:'Advance beyond synthetic deadlines'});assert(f.state().auditFindings.some(x=>x.includes('Overdue contingency')));assert.throws(()=>f.command({kind:'contingency',contingencyId:'finance',status:'satisfied',note:'Late satisfaction disallowed'}));f.command({kind:'contingency',contingencyId:'finance',status:'failed',note:'Adverse financing outcome'});assert.equal(f.state().outcome,'terminated');assert.throws(()=>f.command({kind:'stage',stage:'closing',note:'Cannot convert adverse outcome to success'}));f.command({kind:'stage',stage:'archived',note:'Archive failed educational case'});assert.equal(f.state().stage,'archived');},
 'deadlines beyond the four-digit calendar remain ordered without truncated ISO years':()=>{const futurePack=parseTransactionPack({...pack,jurisdiction:{...pack.jurisdiction,effectiveFrom:'9999-01-01',effectiveThrough:'9999-12-31'}});const futureAssignment=parseTransactionAssignment({...assignment,pack:futurePack,startDate:'9999-12-30'});const f=fixture(futureAssignment);prepare(f);f.command({kind:'offer',offerId:'future-offer',party:'buyer',clientId:'alicefund',price:100,earnest:1,expiresOn:'9999-12-30',closingDate:'9999-12-31',note:'Calendar-boundary synthetic offer'});f.command({kind:'accept',offerId:'future-offer',party:'seller',note:'Accept exact future terms'});f.command({kind:'clock',date:'9999-12-31',note:'Last supported calendar day'});assert(!f.state().auditFindings.some(x=>/Overdue contingency|earnest funds are overdue/.test(x)),'A deadline in year10000 cannot be truncated into a false overdue date');f.command({kind:'contingency',contingencyId:'title',status:'satisfied',note:'Still before the authored deadline'});assert.equal(f.state().contingencies.title,'satisfied');},
 'client funds cannot subsidize another client and reversals append':()=>{const f=fixture();f.command({kind:'deposit',entryId:'d1',clientId:'alicefund',amount:500,reference:'ref1',note:'Client A funds'});assert.throws(()=>f.command({kind:'disburse',entryId:'bad',clientId:'bobfund',amount:1,reference:'bad1',note:'No borrowing client funds'}));assert.throws(()=>f.command({kind:'deposit',entryId:'d2',clientId:'bobfund',amount:1,reference:'ref1',note:'Duplicate ref'}));f.command({kind:'reverse',entryId:'r1',targetEntryId:'d1',reference:'rev1',note:'Correct original deposit'});assert.equal(f.state().entries.length,2);assert.equal(f.state().cashRegister,0);assert.throws(()=>f.command({kind:'reverse',entryId:'r2',targetEntryId:'d1',reference:'rev2',note:'Double reversal'}));},
 'three-way reconciliation independently detects every discrepancy':()=>{const f=fixture();f.command({kind:'deposit',entryId:'d',clientId:'alicefund',amount:500,reference:'d',note:'Funds'});f.command({kind:'reconcile',bankBalance:400,outstandingEntryIds:[],reportedClientBalances:{alicefund:300,bobfund:100},note:'Intentional educational discrepancy'});const r=f.state().reconciliation!;assert.equal(r.issues.length,4);assert.equal(r.cashRegister,500);assert.equal(r.clientLedgerTotal,400);assert.equal(r.expectedClientBalances.alicefund,500);assert.throws(()=>f.command({kind:'reconcile',bankBalance:0,outstandingEntryIds:['d','d'],reportedClientBalances:{alicefund:500,bobfund:0},note:'Double counted outstanding'}));assert.throws(()=>f.command({kind:'reconcile',bankBalance:0,outstandingEntryIds:['unknown'],reportedClientBalances:{alicefund:500,bobfund:0},note:'Unknown outstanding'}));f.command({kind:'reconcile',bankBalance:0,outstandingEntryIds:['d'],reportedClientBalances:{alicefund:500,bobfund:0},note:'Deposit in transit reconciles'});assert.equal(f.state().reconciliation!.adjustedBank,500);assert.deepEqual(f.state().reconciliation!.issues,[]);},
 'outstanding disbursement subtracts exactly once':()=>{const f=fixture();f.command({kind:'deposit',entryId:'d',clientId:'alicefund',amount:500,reference:'d',note:'Cleared deposit'});f.command({kind:'disburse',entryId:'c',clientId:'alicefund',amount:100,reference:'c',note:'Outstanding check'});f.command({kind:'reconcile',bankBalance:500,outstandingEntryIds:['c'],reportedClientBalances:{alicefund:400,bobfund:0},note:'Deduct outstanding check'});assert.equal(f.state().reconciliation!.adjustedBank,400);assert.deepEqual(f.state().reconciliation!.issues,[]);},
 'negative bank statement remains an audit risk despite matching adjusted totals':()=>{const f=fixture();f.command({kind:'deposit',entryId:'d',clientId:'alicefund',amount:110,reference:'d',note:'Outstanding deposit'});f.command({kind:'disburse',entryId:'c',clientId:'alicefund',amount:10,reference:'c',note:'Cleared payment'});f.command({kind:'reconcile',bankBalance:-10,outstandingEntryIds:['d'],reportedClientBalances:{alicefund:100,bobfund:0},note:'Adjusted totals alone conceal negative statement'});assert.equal(f.state().reconciliation!.adjustedBank,100);assert(f.state().reconciliation!.issues.some(x=>x.includes('negative balance')));},
 'money overflow and exact earnest rule reject unsafe calculations':()=>{const f=fixture();f.command({kind:'deposit',entryId:'max',clientId:'alicefund',amount:Number.MAX_SAFE_INTEGER,reference:'max',note:'Boundary integer'});assert.throws(()=>f.command({kind:'deposit',entryId:'over',clientId:'bobfund',amount:1,reference:'over',note:'Total overflow'}));assert.throws(()=>f.command({kind:'deposit',entryId:'nan',clientId:'alicefund',amount:NaN,reference:'nan',note:'NaN'}));const g=fixture();prepare(g);assert.throws(()=>g.command({kind:'offer',offerId:'bad',party:'buyer',clientId:'alicefund',price:101,earnest:1,expiresOn:'2026-10-30',closingDate:'2026-11-01',note:'Below exact 1 percent'}));},
 'closing requires exact documents, required contingencies and current bank reconciliation':()=>{const f=accepted();assert.throws(()=>f.command({kind:'stage',stage:'closing',note:'Unresolved requirements'}));for(const contingencyId of ['title','inspection','finance'])f.command({kind:'contingency',contingencyId,status:'satisfied',note:'Resolved'});f.command({kind:'deposit',entryId:'d',clientId:'alicefund',amount:1000,reference:'d',note:'Earnest funds'});f.command({kind:'reconcile',bankBalance:1000,outstandingEntryIds:[],reportedClientBalances:{alicefund:1000,bobfund:0},note:'Balanced'});assert.throws(()=>f.command({kind:'stage',stage:'closing',note:'Required form answer absent'}));f.setResponse(answer);f.command({kind:'stage',stage:'closing',note:'All declared requirements met'});assert.equal(f.state().outcome,'closed');const edited={...f.session,response:{values:{},annotations:[]}};assert.throws(()=>parseTransactionSession(edited,assignment),'Closed answers cannot be edited into an incomplete archive');assert.equal(replayTransaction(assignment,f.session.events).outcome,'closed','Historical close retains its exact event response');},
 'immutable evidence derives state and rejects forged journal or totals':()=>{const f=fixture();prepare(f);const evidence=makeTransactionSubmission(assignment,f.session,'evidence',new Date(Date.parse(at)+100000).toISOString());f.session.response.values.form={reason:'later'};assert.deepEqual(evidence.session.response.values,{});assert.throws(()=>parseTransactionSubmission({...evidence,cashRegister:999}));const altered=structuredClone(evidence);altered.session.events[0].command={kind:'stage',stage:'closing',note:'Forged jump'};assert.throws(()=>parseTransactionSubmission(altered));assert.equal(replayTransaction(evidence.assignment,evidence.session.events).outcome,'in-progress');},
 'library retained sources, learner tombstones and quarantine refs':()=>{const f=fixture();const evidence=makeTransactionSubmission(assignment,f.session,'evidence',at);const library={...emptyTransactionLibrary(),packs:[pack],assignments:[assignment],sessions:[f.session],submissions:[evidence],pendingApproval:['pack@1'],restoredAt:at};assert.equal(parseTransactionLibrary(library).pendingApproval?.[0],'pack@1');assert.throws(()=>parseTransactionLibrary({...library,pendingApproval:['missing@1']}));assert.throws(()=>parseTransactionLibrary({...library,deletedStudentIds:['alice']}));assert.throws(()=>parseTransactionLibrary({...library,packs:[{...pack,title:'Changed under assignment'}]}));assert.throws(()=>parseTransactionLibrary({...library,feedback:[{id:'review',submissionId:'missing',at,actor:'Teacher',status:'reviewed',note:'Orphan'}]}));},
 'malformed transport, unknown commands and event ordering reject':()=>{assert.throws(()=>parseTransactionPack('{bad'));assert.throws(()=>parseTransactionPack(JSON.parse('{"__proto__":{}}')));const f=fixture();assert.throws(()=>f.command({kind:'eval',note:'No code',script:'1'} as any));f.command({kind:'stage',stage:'representation',note:'Review'});const session=structuredClone(f.session);session.events.push({...session.events[0],id:'duplicate-time',at:'2025-01-01T00:00:00Z'});assert.throws(()=>parseTransactionSession(session,assignment));},
};
for(const [name,test] of Object.entries(tests)){test();console.log('ok '+name);}
console.log(`${Object.keys(tests).length} transaction model groups passed`);
