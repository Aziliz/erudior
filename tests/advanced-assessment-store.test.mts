import assert from 'node:assert/strict';
import { fixture } from './advanced-assessment-model.test.mts';
import { createAdvancedAssessmentStore, deleteAdvancedAssessmentStudent } from '../src/lib/advancedAssessmentStore.ts';
import { parseAdvancedAssessmentLibrary } from '../src/lib/advancedAssessment.ts';
let text:string|null=null, profile='alice', authority='unlocked', tick=0;
let queue=Promise.resolve();
const update=async(change:(s:string|null)=>Promise<string>)=>{let result='';const work=queue.then(async()=>{result=await change(text);text=result;});queue=work.catch(()=>{});await work;return result;};
const io={read:async()=>text,update,authorizeAdult:async(id?:string)=>{if(id&&!['alice','bob'].includes(id))throw Error('Unknown learner');return {actorId:'adult',actorName:'Teacher',authorityKey:authority};},learnerContext:async()=>({studentId:profile,authorityKey:'profile:'+profile}),now:()=>new Date(Date.UTC(2026,9,29,0,0,tick++)).toISOString()};
const {supervisor,learner}=createAdvancedAssessmentStore(io);
const first=await supervisor.savePack(fixture,null);assert.equal(first.revision,1);assert(!first.approval);assert.deepEqual(await supervisor.savePack(fixture,null),first);
const input={id:'case',studentId:'alice',title:'Fictional project',instructions:'Use fictional data.',pack:first,variantId:'a'};
await assert.rejects(supervisor.assign(input,null),/approved/);
const approved=await supervisor.approvePack(first.id,1);assert.deepEqual(await supervisor.approvePack(first.id,1),approved);assert.equal((await supervisor.load()).packReviews.length,1);
const assigned=await supervisor.assign({...input,pack:approved},null);assert.deepEqual(await supervisor.assign({...input,pack:approved},null),assigned);
const command={kind:'assistance' as const,text:'Expected synthetic response'};
const session=await learner.command('case',1,command,'event1',null);assert.equal(session.revision,1);assert.deepEqual(await learner.command('case',1,command,'event1',null),session);
await assert.rejects(learner.command('case',1,{...command,text:'Changed'},'event1',1),/identity/);
const evidence=await learner.submit('case',1,'submission',1);assert.deepEqual(await learner.submit('case',1,'submission',1),evidence);
const feedback=await supervisor.review({id:'review',submissionId:'submission',status:'needs_revision',note:'Explain reasoning',previousReviewId:null,rubricRatings:[{criterionId:'explanation',levelId:'developing',note:'Needs more detail'}],misconceptions:[]});assert.deepEqual(await supervisor.review({id:'review',submissionId:'submission',status:'needs_revision',note:'Explain reasoning',previousReviewId:null,rubricRatings:[{criterionId:'explanation',levelId:'developing',note:'Needs more detail'}],misconceptions:[]}),feedback);
await assert.rejects(supervisor.review({id:'review',submissionId:'submission',status:'reviewed',note:'Changed',previousReviewId:null,rubricRatings:[{criterionId:'explanation',levelId:'developing',note:'Needs more detail'}],misconceptions:[]}),/identity/);
await supervisor.savePack({...approved,title:'Unassigned private source'},1);assert.equal((await learner.load()).packs.length,1);
profile='bob';const other=await learner.load();assert.equal(other.assignments.length,0);assert.equal(other.submissions.length,0);assert.equal(other.packReviews.length,0);await assert.rejects(learner.command('case',1,command,'other',1),/belongs/);profile='alice';
const approved2=await supervisor.approvePack(first.id,2);await supervisor.assign({...input,pack:approved2},1);await assert.rejects(learner.command('case',1,command,'stale',1),/changed/);assert.deepEqual((await supervisor.load()).submissions[0],evidence);
const races=await Promise.allSettled([learner.command('case',2,command,'concurrent1',null),learner.command('case',2,{kind:'assistance',text:'Concurrent hypothesis'},'concurrent2',null)]);assert.equal(races.filter(x=>x.status==='fulfilled').length,1);
const before=text;const changedAdult=createAdvancedAssessmentStore({...io,update:async(change:any)=>{authority='changed';return update(change);}});await assert.rejects(changedAdult.supervisor.savePack({...fixture,id:'new'},null),/authority changed/);assert.equal(text,before);
const changedProfile=createAdvancedAssessmentStore({...io,update:async(change:any)=>{profile='bob';return update(change);}});profile='alice';await assert.rejects(changedProfile.learner.command('case',2,{kind:'assistance',text:'Race'},'race',1),/profile changed/);assert.equal(text,before);profile='alice';
const restored=parseAdvancedAssessmentLibrary(text);restored.pendingApproval=restored.packs.map(p=>`${p.id}@${p.revision}`);restored.restoredAt=io.now();text=JSON.stringify(restored);await assert.rejects(learner.command('case',2,{kind:'assistance',text:'Quarantine'},'restore',1),/fresh adult review/);
const assignedSnapshot=structuredClone(restored.assignments);const receipts=restored.packReviews.length;await supervisor.approvePack(first.id,2);assert.equal((await supervisor.load()).packReviews.length,receipts+1);assert.deepEqual((await supervisor.load()).assignments,assignedSnapshot);assert.deepEqual((await supervisor.load()).submissions[0],evidence);
let deleted=false;const deletionRace=createAdvancedAssessmentStore({...io,update:async change=>{if(!deleted){deleted=true;text=JSON.stringify(deleteAdvancedAssessmentStudent(parseAdvancedAssessmentLibrary(text),'alice'));}return update(change);}});await assert.rejects(deletionRace.learner.command('case',2,{kind:'assistance',text:'Delete race'},'delete',1),/deleted/);const removed=parseAdvancedAssessmentLibrary(text);assert.equal(removed.assignments.length,0);assert.equal(removed.sessions.length,0);assert.equal(removed.submissions.length,0);assert.equal(removed.feedback.length,0);assert.deepEqual(deleteAdvancedAssessmentStudent(removed,'alice'),removed);await assert.rejects(learner.load(),/deleted/);await assert.rejects(supervisor.assign({...input,id:'resurrect',pack:approved2},null),/deleted/);
let freshText:string|null=null;profile='bob';const fresh=createAdvancedAssessmentStore({...io,read:async()=>freshText,update:async c=>freshText=await c(freshText)});await fresh.supervisor.savePack(fixture,null);const freshPack=await fresh.supervisor.approvePack(fixture.id,1);await fresh.supervisor.assign({...input,id:'fresh',studentId:'bob',pack:freshPack},null);const checkpoint=await fresh.learner.submit('fresh',1,'untouched',null);assert.deepEqual(await fresh.learner.submit('fresh',1,'untouched',null),checkpoint);
console.log('Advanced assessment store: exact approval, immutable source/history, retries, concurrent CAS, fresh profile/credential checks, quarantine review provenance and deletion passed');
await fresh.learner.command('fresh',1,command,'after-empty',null);assert.deepEqual(await fresh.learner.submit('fresh',1,'untouched',null),checkpoint,'interrupted retry returns original evidence even after later practice');await assert.rejects(fresh.learner.submit('fresh',1,'untouched',1),/identity/);
// Human review corrections are append-only and compare the exact previous review ID.
const rubricRatings=[{criterionId:'explanation',levelId:'developing',note:'Checkpoint remains incomplete.'}];
const reviewInput={id:'r1',submissionId:'untouched',status:'needs_revision' as const,note:'First local review',previousReviewId:null,rubricRatings,misconceptions:[]};
const r1=await fresh.supervisor.review(reviewInput);assert.deepEqual(await fresh.supervisor.review(reviewInput),r1);
await assert.rejects(fresh.supervisor.review({...reviewInput,id:'stale',note:'Stale overwrite'}),/Review changed/);
await fresh.supervisor.review({...reviewInput,id:'r2',previousReviewId:'r1',note:'Revised review explanation'});assert.deepEqual((await fresh.supervisor.load()).feedback[0],r1);
let imported=parseAdvancedAssessmentLibrary(freshText);imported.pendingReviewIds=imported.feedback.map(f=>f.id);imported.pendingApproval=imported.packs.map(p=>`${p.id}@${p.revision}`);freshText=JSON.stringify(imported);
await assert.rejects(fresh.supervisor.review({...reviewInput,id:'r3',previousReviewId:'r2'}),/restored source/);await fresh.supervisor.approvePack(fixture.id,1);assert.deepEqual((await fresh.supervisor.load()).pendingReviewIds,['r1','r2']);await fresh.supervisor.review({...reviewInput,id:'r3',previousReviewId:'r2',note:'Fresh local review after inspecting restored evidence'});assert.deepEqual((await fresh.supervisor.load()).pendingReviewIds,['r1','r2']);assert(!(await fresh.supervisor.load()).pendingReviewIds?.includes('r3'));
const invalidReview={...reviewInput,id:'bad-reference',previousReviewId:'r3',misconceptions:[{misconceptionId:'operation',questionId:'reason',stepId:'first',note:'No captured answer to support this.'}]};await assert.rejects(fresh.supervisor.review(invalidReview),/captured evidence/);
const invalidRubric={...reviewInput,id:'bad-rubric',previousReviewId:'r3',rubricRatings:[{criterionId:'unknown',levelId:'developing',note:'Wrong rubric'}]};await assert.rejects(fresh.supervisor.review(invalidRubric),/rubric/);
const deletion=deleteAdvancedAssessmentStudent(parseAdvancedAssessmentLibrary(freshText),'bob');assert.deepEqual(deletion.pendingReviewIds,[]);assert.equal(deletion.feedback.length,0);
console.log('Advanced assessment review: exact rubric/evidence references, stale review CAS, historical restore quarantine and privacy deletion passed');
