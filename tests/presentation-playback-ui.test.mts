invalid=true;await click('Open presentation room');assert.equal(fetches,0,'invalid source blocks room creation');invalid=false;await click('Open presentation room');assert.equal(fetches,1);invalid=true;
await React.act(async()=>finishOpen({ok:true,json:async()=>({code:'BCD234',token:'secret2',joinUrl:'https://app.example.org/?presentation=BCD234'})}));
const raced=WS.all.at(-1)!;await React.act(async()=>{raced.onopen?.();raced.message(lobby)});assert.equal(raced.sent.filter(m=>m.t==='setup').length,0,'changed source must never be uploaded');assert(raced.sent.some(m=>m.t==='close'),'newly created room closes after source invalidation');
await React.act(async()=>raced.message({t:'closed',message:'Closed'}));
