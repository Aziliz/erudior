import assert from 'node:assert/strict';
import {webcrypto} from 'node:crypto';
if(!globalThis.crypto)Object.defineProperty(globalThis,'crypto',{value:webcrypto});
import {learnerPrivacyFixture,learnerPrivacyProgress} from './fixtures/learnerPrivacy';
import {applyLearnerSnapshot,captureLearnerSnapshot,decryptLearnerSnapshot,encryptLearnerSnapshot,learnerCanonical,parseLearnerEnvelope,parseLearnerSnapshot,parseLearnerTrust,previewLearnerRestore,signLearnerGrant,validateLearnerGrant} from '../src/lib/learnerPrivacy';
const f=await learnerPrivacyFixture();
assert.equal(validateLearnerGrant(f.signedGrant,f.trust,f.now,'write').authority,'verified-guardian');
for(const now of [f.now-1,f.now+120])assert.throws(()=>validateLearnerGrant(f.signedGrant,f.trust,now,'read'));
for(const changes of [{audience:'https://wrong.example.test'},{issuer:'wrong'},{namespace:'wrong'},{authority:'minor-self'},{consentVersion:2},{expiresAt:f.now+301},{scopes:['read','read']}]){
 assert.throws(()=>validateLearnerGrant(signLearnerGrant({...f.grant,...changes} as any,'synthetic-key',f.key.secretKey),f.trust,f.now,'write'));
}
assert.throws(()=>validateLearnerGrant({...f.signedGrant,purpose:'issue'},f.trust,f.now,'write'));
assert.throws(()=>validateLearnerGrant({...f.signedGrant,payload:{...f.grant,profile:'other-profile'}},f.trust,f.now,'write'));
assert.throws(()=>validateLearnerGrant(f.signedGrant,{...f.trust,keys:[{id:'synthetic-key',publicKey:btoa('x'.repeat(32))}]},f.now,'read'));
assert.throws(()=>parseLearnerTrust({...f.trust,keys:[...f.trust.keys,...f.trust.keys]}));
assert.throws(()=>parseLearnerTrust({...f.trust,secretKey:'not allowed'}));
assert.deepEqual(await decryptLearnerSnapshot(f.envelope,f.passphrase,f.binding),f.snapshot);
assert.notDeepEqual(await encryptLearnerSnapshot(f.snapshot,f.passphrase,f.binding),f.envelope);
await assert.rejects(()=>decryptLearnerSnapshot(f.envelope,'wrong passphrase',f.binding));
await assert.rejects(()=>decryptLearnerSnapshot(f.envelope,f.passphrase,{...f.binding,profile:'other-profile'}));
await assert.rejects(()=>decryptLearnerSnapshot({...f.envelope,binding:{...f.binding,profile:'other-profile'}},f.passphrase,{...f.binding,profile:'other-profile'}));
assert.throws(()=>parseLearnerEnvelope({...f.envelope,kdf:{...f.envelope.kdf,iterations:1}}));
assert.throws(()=>parseLearnerEnvelope({...f.envelope,iv:btoa('x')}));
assert.throws(()=>parseLearnerEnvelope({...f.envelope,plaintext:f.snapshot}));
assert.throws(()=>parseLearnerSnapshot({...f.snapshot,courses:[...f.snapshot.courses,...f.snapshot.courses]}));
assert.throws(()=>parseLearnerSnapshot({...f.snapshot,courses:[{...f.snapshot.courses[0],lessons:[{lessonId:'lesson-one',completedOn:'2026-02-30'}]}]}));
assert.throws(()=>parseLearnerSnapshot({...f.snapshot,courses:[{...f.snapshot.courses[0],practice:{attempts:1,correct:2}}]}));
assert.throws(()=>parseLearnerSnapshot({...f.snapshot,family:{name:'secret'}}));
assert.equal(learnerCanonical(f.snapshot).includes('Private note'),false);
assert.deepEqual(f.snapshot.courses[0].lessons,[{lessonId:'lesson-one',completedOn:'2026-10-29'}]);
assert.deepEqual(f.snapshot.courses[0].practice,{attempts:3,correct:2});
assert.equal((await previewLearnerRestore(f.snapshot,[f.course]))[0].status,'ready');
assert.equal((await previewLearnerRestore(f.snapshot,[]))[0].status,'missing');
assert.equal((await previewLearnerRestore(f.snapshot,[{...f.course,title:'Changed source'}]))[0].status,'changed');
const current=learnerPrivacyProgress();current.lessonsDone={'unrelated/local':'2026-10-20'};current.drills={'private/drill':{attempts:77,correct:66}};
const result=await applyLearnerSnapshot(current,f.snapshot,[f.course],[f.course.id]);
assert.deepEqual(result.lessonsDone,{'unrelated/local':'2026-10-20','synthetic-practice/lesson-one':'2026-10-29'});
assert.equal(result.drills,current.drills);assert.equal(result.qmeta,current.qmeta);assert.equal(result.attempts,current.attempts);
assert.equal(current.lessonsDone['synthetic-practice/lesson-one'],undefined);
const existing={...current,lessonsDone:{'synthetic-practice/lesson-one':'2025-01-01'}};
assert.equal((await applyLearnerSnapshot(existing,f.snapshot,[f.course],[f.course.id])).lessonsDone['synthetic-practice/lesson-one'],'2025-01-01');
await assert.rejects(()=>applyLearnerSnapshot(current,f.snapshot,[{...f.course,revision:2}],[f.course.id]));
await assert.rejects(()=>captureLearnerSnapshot(f.progress,[f.course,f.course],[f.course.id]));
await assert.rejects(()=>captureLearnerSnapshot(f.progress,[f.course],[]));
await assert.rejects(()=>captureLearnerSnapshot(f.progress,[{...f.course,drills:[...f.course.drills,...f.course.drills]}],[f.course.id]));
const forged={...f.snapshot,courses:[{...f.snapshot.courses[0],lessons:[{lessonId:'quiz-gated',completedOn:'2026-10-29'}]}]};
await assert.rejects(()=>applyLearnerSnapshot(current,forged,[f.course],[f.course.id]));
console.log('learner privacy model: minimal capture, frozen source, non-scoring recovery, encryption and separate scoped auth passed');
