          "id": "q-add",
          "topic": "Numbers",
          "stem": "What is $2 + 3$?",
          "choices": [
            "4",
            "5",
            "6"
          ],
          "answer": 1,
          "explanation": "Two and three more make five: $2 + 3 = 5$."
        },
        {
          "id": "q-abc",
          "topic": "Numbers",
          "type": "order",
          "stem": "Put the letters in ABC order.",
          "choices": [
            "a",
            "b",
            "c",
            "d"
          ],
          "explanation": "a, b, c, d."
        },
        {
          "id": "q-sun",
          "topic": "Letter sounds",
          "stem": "Listen. Which word did you hear?",
          "listen": "sun",
          "choices": [
            "sun",
            "sit",
            "map"
          ],
          "answer": 0,
          "explanation": "You heard sun: s, u, n."
        },
        {
          "id": "q-cat",
          "topic": "Blending",
          "stem": "Tap each sound, then say them fast. Which word is it?",
          "blend": [
            "c",
            "a",
            "t"
          ],
          "choices": [
            "cat",
            "cot",
            "cut"
          ],
          "answer": 0,
          "explanation": "c, a, t makes cat."
        },
        {
          "id": "q-ship",
          "topic": "Blending",
          "stem": "Tap each sound, then say them fast. Which word is it?",
          "blend": [
            "sh",
            "i",
            "p"
          ],
          "choices": [
            "shop",
            "ship",
            "chip"
          ],
          "answer": 1,
