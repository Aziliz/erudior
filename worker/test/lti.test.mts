import assert from 'node:assert/strict';
import { webcrypto } from 'node:crypto';
import { handleLti, type LtiEnv, type LtiRegistration } from '../src/lti.ts';
if (!globalThis.crypto) Object.defineProperty(globalThis,'crypto',{value:webcrypto});
const C='https://purl.imsglobal.org/spec/lti/claim/';
const pair=await crypto.subtle.generateKey({name:'RSASSA-PKCS1-v1_5',modulusLength:2048,publicExponent:new Uint8Array([1,0,1]),hash:'SHA-256'},true,['sign','verify']);
const key={...await crypto.subtle.exportKey('jwk',pair.publicKey),kid:'test-key',alg:'RS256',use:'sig'};
const registration:LtiRegistration={issuer:'https://platform.example',clientId:'client',deploymentId:'deployment',authorizationEndpoint:'https://platform.example/authorize',targets:['https://app.example/course/test'],keys:[key]};
const records=new Map<string,any>();
let dbCalls=0;
const DB={prepare(sql:string){dbCalls++;let args:any[]=[];return {bind(...values:any[]){args=values;return this;},async run(){if(sql.startsWith('DELETE')){for(const [k,v] of records)if(v.expires<=args[0])records.delete(k);return {meta:{changes:0}};}assert.ok(sql.startsWith('INSERT'));assert.ok(sql.includes('registration_hash = ?) < 500'));if(records.size>=10000||[...records.values()].filter(r=>r.registration_hash===args[6]).length>=500)return {meta:{changes:0}};const [state_hash,binding_hash,nonce_hash,registration_hash,target,expires]=args;records.set(state_hash,{state_hash,binding_hash,nonce_hash,registration_hash,target,expires});return {meta:{changes:1}};},async first(){const row=records.get(args[0]);if(!row||row.binding_hash!==args[1]||row.expires<=args[2])return null;records.delete(args[0]);return row;}};}};
const env={DB,API_ORIGIN:'https://api.example',APP_ORIGIN:'https://app.example',LTI_REGISTRATIONS:JSON.stringify([registration])} as unknown as LtiEnv;
function init(extra:Record<string,string>={}){return new URLSearchParams({iss:registration.issuer,client_id:registration.clientId,lti_deployment_id:registration.deploymentId,target_link_uri:registration.targets[0],login_hint:'private-hint',...extra});}
async function start(extra:Record<string,string>={},post=false){const p=init(extra);const req=new Request('https://api.example/lti/login'+(post?'':'?'+p),post?{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded',Origin:'https://platform.example'},body:p}:{});const response=await handleLti(req,env);assert.equal(response.status,302,await response.clone().text());const auth=new URL(response.headers.get('Location')!);assert.equal(auth.origin,'https://platform.example');assert.equal(auth.searchParams.get('response_mode'),'form_post');assert.equal(auth.searchParams.get('redirect_uri'),'https://api.example/lti/launch');assert.equal(auth.searchParams.get('scope'),'openid');assert.equal(auth.searchParams.get('prompt'),'none');assert.match(response.headers.get('Set-Cookie')!,/Secure; HttpOnly; SameSite=None/);return {auth,cookie:response.headers.get('Set-Cookie')!.split(';')[0],state:auth.searchParams.get('state')!,nonce:auth.searchParams.get('nonce')!};}
const b64=(v:unknown)=>Buffer.from(JSON.stringify(v)).toString('base64url');
async function signed(s:Awaited<ReturnType<typeof start>>,patch:Record<string,unknown>={},header:Record<string,unknown>={}){const now=Math.floor(Date.now()/1000);const claims={iss:registration.issuer,aud:registration.clientId,sub:'synthetic-user',iat:now,exp:now+120,nonce:s.nonce,[C+'message_type']:'LtiResourceLinkRequest',[C+'version']:'1.3.0',[C+'deployment_id']:registration.deploymentId,[C+'target_link_uri']:registration.targets[0],[C+'resource_link']:{id:'resource'},[C+'roles']:['http://purl.imsglobal.org/vocab/lis/v2/membership#Instructor'],email:'private@example.test',...patch};const body=b64({alg:'RS256',kid:'test-key',...header})+'.'+b64(claims);return body+'.'+Buffer.from(await crypto.subtle.sign('RSASSA-PKCS1-v1_5',pair.privateKey,new TextEncoder().encode(body))).toString('base64url');}
async function launch(s:Awaited<ReturnType<typeof start>>,token:string,cookie=s.cookie,extra=''){return handleLti(new Request('https://api.example/lti/launch',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded',Cookie:cookie,Origin:'https://platform.example'},body:new URLSearchParams({state:s.state,id_token:token}).toString()+extra}),env);}
const disabled=await handleLti(new Request('https://api.example/lti/login'),{...env,LTI_REGISTRATIONS:undefined});assert.equal(disabled.status,404);assert.equal(dbCalls,0);
for(const post of [false,true]){const s=await start({},post),jwt=await signed(s),res=await launch(s,jwt);assert.equal(res.status,303);assert.equal(res.headers.get('Location'),registration.targets[0]);assert.equal(res.headers.get('Cache-Control'),'no-store');assert.match(res.headers.get('Set-Cookie')!,/Max-Age=0/);assert.equal(res.headers.has('Access-Control-Allow-Origin'),false);assert.equal(await res.text(),'');assert.equal((await launch(s,jwt)).status,400);}
for(const patch of [{iss:'https://evil.example'},{aud:'other'},{aud:['client','other']},{azp:'other'},{exp:0},{iat:Math.floor(Date.now()/1000)+1000},{nonce:'other'},{[C+'deployment_id']:'other'},{[C+'target_link_uri']:'https://evil.example'},{[C+'resource_link']:{id:''}},{[C+'roles']:'Instructor'},{[C+'roles']:['https://invalid.example/role']},{nbf:Math.floor(Date.now()/1000)+1000},{[C+'message_type']:'LtiDeepLinkingRequest'},{[C+'version']:'1.1.0'},{sub:'\ninvalid'}]){const s=await start();assert.equal((await launch(s,await signed(s,patch))).status,400,JSON.stringify(patch));}
for(const header of [{alg:'none'},{alg:'HS256'},{kid:'missing'},{jku:'https://evil.example/key'},{crit:['unknown']}]){const s=await start();assert.equal((await launch(s,await signed(s,{},header))).status,400);}
{const s=await start();const jwt=await signed(s);assert.equal((await launch(s,jwt,'')).status,400);assert.equal((await launch(s,jwt,s.cookie.replace(/=.+$/,'='+'A'.repeat(43)))).status,400);assert.equal((await launch(s,jwt)).status,303,'Invalid browser binding must not consume legitimate state');}
{const s=await start();const jwt=await signed(s);const responses=await Promise.all([launch(s,jwt),launch(s,jwt)]);assert.deepEqual(responses.map(r=>r.status).sort(),[303,400]);}
{const s=await start();assert.equal((await launch(s,await signed(s,{sub:undefined,[C+'roles']:[]}))).status,303,'Anonymous launch supported');}
{const s=await start();assert.equal((await launch(s,await signed(s),s.cookie,'&state=duplicate')).status,400);}
{const s=await start();const token=await signed(s);const altered=token.slice(0,-10)+'AAAAAAAAAA';assert.equal((await launch(s,altered)).status,400);}
for(const extra of [{iss:'https://unknown.example'},{target_link_uri:'https://app.example/course/test?next=evil'},{client_id:'other'},{client_id:''},{lti_deployment_id:'other'},{lti_deployment_id:''}]){const r=await handleLti(new Request('https://api.example/lti/login?'+init(extra)),env);assert.equal(r.status,400);}
{const r=await handleLti(new Request('https://api.example/lti/login?'+init()+'&iss=duplicate'),env);assert.equal(r.status,400);}
{const r=await handleLti(new Request('https://api.example/lti/launch',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:'x='+ 'a'.repeat(50000)}),env);assert.equal(r.status,413);}
{const r=await handleLti(new Request('https://api.example/lti/launch',{method:'POST',headers:{'Content-Type':'application/json'},body:'{}'}),env);assert.equal(r.status,415);}
{const s=await start();const jwt=await signed(s);env.LTI_REGISTRATIONS=JSON.stringify([{...registration,keys:[]}]);assert.equal((await launch(s,jwt)).status,400);env.LTI_REGISTRATIONS=JSON.stringify([registration]);}
{const s=await start();const jwt=await signed(s);for(const row of records.values())row.expires=0;assert.equal((await launch(s,jwt)).status,400,'Expired state rejected');}
{const s=await start();assert.equal((await launch(s,await signed(s,{[C+'roles']:['http://purl.imsglobal.org/vocab/lis/v2/membership/Instructor#TeachingAssistant']}))).status,303);}
{const original=env.LTI_REGISTRATIONS;env.LTI_REGISTRATIONS=JSON.stringify([registration,{...registration,clientId:'another'}]);const p=init();p.delete('client_id');assert.equal((await handleLti(new Request('https://api.example/lti/login?'+p),env)).status,400,'Ambiguous registration rejected');env.LTI_REGISTRATIONS=original;}
{records.clear();const s=await start();const seed=[...records.values()][0];for(let i=0;i<499;i++)records.set('queued-'+i,{...seed,state_hash:'queued-'+i});const r=await handleLti(new Request('https://api.example/lti/login?'+init()),env);assert.equal(r.status,429);assert.equal(records.size,500,'Per-registration pending state remains bounded');records.clear();}
assert.ok([...records.values()].every(r=>!JSON.stringify(r).includes('private')&&!JSON.stringify(r).includes('synthetic-user')));
console.log('LTI resource-link protocol, cryptography, browser binding, replay and privacy tests passed.');
