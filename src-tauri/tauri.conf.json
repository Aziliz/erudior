{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Erudior",
  "version": "0.18.0",
  "identifier": "com.erudior.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Erudior",
        "width": 1200,
        "height": 820,
        "minWidth": 820,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://courses.erudior.com https://api.erudior.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage",
      "nsis",
      "msi"
    ],
    "category": "Education",
    "shortDescription": "Free courses and homeschool records",
    "longDescription": "Erudior is a free learning app: courses with lessons, practice exams, spaced-repetition notecards, math drills and vocabulary, plus homeschool records (attendance, grades, reports) kept on the family's computer.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "section": "education"
      },
      "rpm": {
        "release": "1"
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcyMTVGRENGRUNCODQ5RjIKUldUeVNianN6LzBWY25xWFBhRXhTU2UrWlJSM0lBV2ZZUWNLOUN3WjJ5b1R5U2UxeUgxWVhnam0K",
      "endpoints": [
        "https://github.com/Aziliz/examiner/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
