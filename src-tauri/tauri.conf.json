{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Erudior",
  "version": "0.25.0",
  "identifier": "com.erudior.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Erudior",
        "width": 1200,
        "height": 820,
        "minWidth": 820,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://cdn.jsdelivr.net/npm/pyodide@314.0.7/; worker-src 'self'; connect-src 'self' https://courses.erudior.com https://api.erudior.com wss://api.erudior.com https://cdn.jsdelivr.net/npm/pyodide@314.0.7/; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self' data: blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage",
      "nsis",
      "msi",
      "app",
      "dmg"
    ],
    "category": "Education",
    "shortDescription": "Free courses and homeschool records",
    "longDescription": "Erudior is a free learning app: courses with lessons, practice exams, spaced-repetition notecards, math drills and vocabulary, plus homeschool records (attendance, grades, reports) kept on the family's computer.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "linux": {
      "deb": {
        "section": "education"
      },
      "rpm": {
        "release": "1"
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true,
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJBQzU1QURBRDY0RTgyQUQKUldTdGdrN1cybHJGdXJFajVvMDR2TWU0ZE5RakViYkV3K0tjTWZKb2hLSjVYdkw5RkVjQnQwV2wK",
      "endpoints": [
        "https://github.com/Aziliz/erudior/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
