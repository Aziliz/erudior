{
  "module": "m2-money",
  "lessons": {
    "m2-appraisal-valuation": {
      "points": [
        {
          "point": "Value vs price vs cost; market value is the most probable price under typical conditions",
          "questions": [
            "h2-001"
          ]
        },
        {
          "point": "Four elements of value (DUST); demand means effective demand",
          "questions": [
            "n2-010"
          ]
        },
        {
          "point": "Substitution: no more than the cost of an equally desirable substitute",
          "questions": [
            "n2-006"
          ]
        },
        {
          "point": "Highest and best use: legally permissible, physically possible, financially feasible, maximally productive",
          "questions": [
            "h2-002"
          ]
        },
        {
          "point": "Conformity (plus supply and demand, change)",
          "questions": [
            "h2-004"
          ]
        },
        {
          "point": "Contribution: a component is worth what it adds, not what it cost",
          "questions": [
            "h2-003"
          ]
        },
        {
          "point": "Progression and regression (overbuilding)",
          "questions": [
            "n2-005"
          ]
        },
        {
          "point": "Anticipation: present worth of future benefits; basis of income approach",
          "questions": [
            "h2-005"
          ]
        },
        {
          "point": "Appraisal by credentialed appraiser vs broker CMA/BPO; never call a CMA an appraisal",
          "questions": [
            "n2-008"
          ]
        },
        {
          "point": "Reconciliation weights the best-suited approach; not an average",
          "questions": [
            "h2-006"
          ]
        },
        {
          "point": "Sales comparison approach is best for single-family homes and land",
          "questions": [
            "n2-001"
          ]
        },
        {
          "point": "Adjust the comp, never the subject (comp better subtract, comp inferior add)",
          "questions": [
            "n2-002"
          ]
        },
        {
          "point": "Cost approach: land + (cost new − accrued depreciation); best for new/special-purpose",
          "questions": [
            "h2-007"
          ]
        },
        {
          "point": "Replacement cost (same utility, modern materials) vs reproduction cost (exact replica)",
          "questions": [
            "h2-008"
          ]
        },
        {
          "point": "Functional obsolescence: design flaws inside the property",
          "questions": [
            "n2-004"
          ]
        },
        {
          "point": "External obsolescence is off-property and always incurable; land doesn't depreciate",
          "questions": [
            "n2-003"
          ]
        },
        {
          "point": "Income approach: PGI − vacancy = EGI − operating expenses = NOI; value = NOI ÷ cap rate",
          "questions": [
            "h2-009"
          ]
        },
        {
          "point": "Operating expenses exclude debt service and income-tax depreciation",
          "questions": [
            "n2-007"
          ]
        },
        {
          "point": "GRM uses monthly rent (1–4 units); GIM uses annual income",
          "questions": [
            "n2-009"
          ]
        },
        {
          "point": "Automated valuation models: data-only estimates, weak where comps are few",
          "questions": [
            "h2-010"
          ]
        }
      ],
